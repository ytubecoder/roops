#!/usr/bin/env python3
"""bin/loopctl — §8 CLI surface for the loops harness. generalissimo's daily interface:
scaffold, validate, run, install/uninstall/pause/resume against launchd,
regenerate the dashboard, and manage findings dispositions.

Design notes (see docs/INTERFACES.md §8/§8.1/§5/§5.1/§5.2/§4.2 for the
authoritative contract):

- `bin/loopconf.py` and `bin/schedule.py` are the frozen single
  implementations (§5.0/§5.1). They are loaded here from THIS script's own
  directory (the repo's `bin/`), never from `--root` — they are library
  code, always co-located with loopctl itself, regardless of what data root
  a given invocation operates against.
- `bin/db.py` is invoked as a subprocess CLI (its documented interface),
  also resolved from this script's own directory.
- `dashboard/generate.py` (Task B, committed) is imported directly (it
  already exposes a `generate(root=..., loopconf_parse=..., schedule_parse=...)`
  seam) so loopctl never needs a copy of loopconf.py under an arbitrary
  `--root`.
- `bin/run-loop.sh` (Task C, built concurrently) and `engines/<engine>.sh`
  (Task D, built concurrently) are resolved relative to `--root` (the data
  root), NOT this script's directory — this lets hermetic tests supply
  fakes for both without ever touching the real, still-being-built files,
  and matches production where `--root` defaults to the same tree that will
  eventually contain them.
- `launchctl` is NEVER invoked directly — every call goes through
  `_launchctl()`, which honours `LOOPS_LAUNCHCTL` (default: `launchctl`).
  Tests point this at a recording stub script and must never exercise the
  real binary.
"""
import argparse
import importlib.util
import json
import os
import plistlib
import re
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

_HERE = os.path.dirname(os.path.abspath(__file__))
_REPO_ROOT = os.path.dirname(_HERE)


# ---------------------------------------------------------------------------
# Module loading (see docstring above for the resolution rules)
# ---------------------------------------------------------------------------

def _load_module_from_path(path, modname):
    spec = importlib.util.spec_from_file_location(modname, path)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load module {modname} from {path}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


loopconf = _load_module_from_path(os.path.join(_HERE, "loopconf.py"), "_loopctl_loopconf")
schedule = _load_module_from_path(os.path.join(_HERE, "schedule.py"), "_loopctl_schedule")
skill_import = _load_module_from_path(
    os.path.join(_HERE, "skill_import.py"), "_loopctl_skill_import"
)
requirements = _load_module_from_path(
    os.path.join(_HERE, "requirements.py"), "_loopctl_requirements"
)

_DB_BIN = os.path.join(_HERE, "db.py")
_DASHBOARD_GENERATE = os.path.join(_REPO_ROOT, "dashboard", "generate.py")

_dashboard_mod_cache = {}


def _dashboard_module():
    if "mod" not in _dashboard_mod_cache:
        _dashboard_mod_cache["mod"] = _load_module_from_path(
            _DASHBOARD_GENERATE, "_loopctl_dashboard"
        )
    return _dashboard_mod_cache["mod"]


# ---------------------------------------------------------------------------
# db.py subprocess helpers
# ---------------------------------------------------------------------------

def _db_run_raw(args_list):
    return subprocess.run(
        [sys.executable, _DB_BIN] + args_list, capture_output=True, text=True, check=False
    )


def _db_run(verb_args, root):
    return _db_run_raw(verb_args + ["--root", root])


def _db_query(root, query_name, **kwargs):
    args_list = ["query", query_name]
    for key, value in kwargs.items():
        if value is None:
            continue
        flag = "--" + key.replace("_", "-")
        args_list += [flag, str(value)]
    r = _db_run(args_list, root)
    if r.returncode != 0:
        return []
    try:
        return json.loads(r.stdout)
    except (ValueError, json.JSONDecodeError):
        return []


def _latest_run_id(root, name):
    rows = _db_query(root, "last-runs", loop=name, limit=1)
    return rows[0]["run_id"] if rows else None


def _record_event(root, loop, event, actor, detail=None):
    """Best-effort: an audit-write failure must never fail the verb (see
    docs/INTERFACES.md §8 Amendment 2)."""
    argv = ["record-event", "--root", root, "--loop", loop, "--event", event, "--actor", actor]
    if detail:
        argv += ["--detail", json.dumps(detail)]
    _db_run_raw(argv)


# ---------------------------------------------------------------------------
# Read-only sqlite helpers (mirrors dashboard/generate.py's own pattern for
# read-only access — never writes, so it's safe to open directly rather than
# adding new db.py query verbs)
# ---------------------------------------------------------------------------

def _open_db_ro(root):
    db_path = os.path.join(root, "state", "loops.sqlite")
    if not os.path.exists(db_path):
        return None
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    return conn


def _current_disposition(conn, loop_name, finding_id):
    if conn is None:
        return None
    row = conn.execute(
        "SELECT * FROM dispositions WHERE loop_name=? AND finding_id=? "
        "ORDER BY created_at DESC LIMIT 1",
        (loop_name, finding_id),
    ).fetchone()
    return dict(row) if row else None


def _format_disposition(disp):
    if disp is None or disp.get("action") == "reopen":
        return "open"
    action = disp["action"]
    date = (disp.get("created_at") or "")[:10]
    if action == "ack":
        return f"acked {date}"
    if action == "dismiss":
        note = disp.get("note") or ""
        return f'dismissed {date} ("{note}")'
    if action == "snooze":
        until = disp.get("snooze_until") or ""
        return f"snoozed until {until}"
    return f"{action} {date}"


def _parse_iso(ts):
    if not ts:
        return None
    ts = ts.strip()
    if ts.endswith("Z"):
        ts = ts[:-1] + "+00:00"
    try:
        return datetime.fromisoformat(ts)
    except ValueError:
        return None


def _age_days(first_seen_at, now):
    dt = _parse_iso(first_seen_at)
    if dt is None:
        return None
    return (now - dt).days


# ---------------------------------------------------------------------------
# launchd — gated launchctl invocation (never call the real binary in tests)
# ---------------------------------------------------------------------------

def _launchctl_bin():
    return os.environ.get("LOOPS_LAUNCHCTL", "launchctl")


def _launchctl(args_list):
    """The ONLY place launchctl is ever invoked from. Honours LOOPS_LAUNCHCTL
    so tests can redirect to a recording stub and never touch the real
    launchd."""
    return subprocess.run(
        [_launchctl_bin()] + args_list, capture_output=True, text=True, check=False
    )


def _service_label(name):
    return f"com.loops.{name}"


# ---------------------------------------------------------------------------
# systemd — gated systemctl invocation, the exact sibling of the seam above
# ---------------------------------------------------------------------------

def _install_backend(platform_name=None):
    """Which init system installs loops on this host.

    Darwin keeps launchd so this repo's hermetic suite still runs on the macOS
    dev box; Linux (firstparty, WSL later) uses systemd user units.
    """
    if platform_name is None:
        # LOOPS_INSTALL_BACKEND lets the hermetic suite exercise the Linux path
        # from the macOS dev box. Explicit argument still wins over it.
        forced = os.environ.get("LOOPS_INSTALL_BACKEND")
        if forced:
            if forced not in ("launchd", "systemd"):
                raise ValueError(f"invalid LOOPS_INSTALL_BACKEND {forced!r}")
            return forced
    name = platform_name or sys.platform
    return "launchd" if name.startswith("darwin") else "systemd"


def _systemctl_bin():
    """Mirror of _launchctl_bin's test seam."""
    return os.environ.get("LOOPS_SYSTEMCTL", "systemctl")


def _systemctl(args_list):
    """The ONLY place systemctl is ever invoked from. Always --user: the fleet
    runs as an unprivileged account with linger on, never as root.

    A non-login ssh shell does not set XDG_RUNTIME_DIR; without it
    `systemctl --user` says "Failed to connect to bus". Default it in the
    child when the parent left it unset.
    """
    env = os.environ.copy()
    if not env.get("XDG_RUNTIME_DIR"):
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    return subprocess.run(
        [_systemctl_bin(), "--user"] + args_list,
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )


def _systemd_unit_dir():
    """Where user units are written. LOOPS_SYSTEMD_UNIT_DIR mirrors
    LOOPS_LAUNCHCTL as a test seam — §11 forbids a test touching anything
    outside the repo, and ~/.config/systemd/user is very much outside it."""
    override = os.environ.get("LOOPS_SYSTEMD_UNIT_DIR")
    if override:
        return override
    home = os.environ.get("HOME", os.path.expanduser("~"))
    return os.path.join(home, ".config", "systemd", "user")


def _systemd_unit_names(name):
    return f"loops-{name}.service", f"loops-{name}.timer"


def _systemd_unit_paths(name):
    unit_dir = _systemd_unit_dir()
    return tuple(os.path.join(unit_dir, u) for u in _systemd_unit_names(name))


def _render_systemd_service(name, root):
    root = os.path.abspath(root)
    home = os.environ.get("HOME", os.path.expanduser("~"))
    log_dir = os.path.abspath(os.path.join(root, "state", "launchd-logs"))
    run_loop_sh = os.path.join(root, "bin", "run-loop.sh")
    return f"""[Unit]
Description=roops loop {name}
After=network-online.target
Wants=network-online.target

[Service]
# One-shot: the timer owns cadence. A restart-on-exit policy here would spin
# a failing loop continuously instead of waiting for its next firing. The
# test for that is a dumb substring check, so do not name the directive.
Type=oneshot
# A oneshot is bounded by DefaultTimeoutStartSec (90s upstream) and real engine
# runs are longer than that — systemd would SIGTERM every scheduled run. The
# runner owns its own timeouts; systemd must not second-guess them.
TimeoutStartSec=infinity
WorkingDirectory={root}
Environment=HOME={home}
Environment=PATH={_runtime_path(home)}
Environment=LOOPS_ROOT={root}
# --trigger launchd is deliberate on Linux too: it is the vocabulary token for
# "the platform scheduler fired this", the same alias-not-a-rewrite rule that
# keeps the com.loops.* labels. Omitting it defaults run-loop.sh to
# --trigger manual, and BOTH of its guards exempt manual — a paused loop and a
# schedule=manual loop would each keep firing.
ExecStart=/bin/bash {run_loop_sh} {name} --trigger launchd
StandardOutput=append:{log_dir}/{name}.out.log
StandardError=append:{log_dir}/{name}.err.log
"""


def _render_systemd_timer(name, systemd_spec):
    if not systemd_spec:
        raise ValueError(
            f"refusing to render a timer for {name}: schedule emits no systemd form "
            "(schedule=manual is never installed)"
        )
    service, _timer = _systemd_unit_names(name)
    lines = [
        "[Unit]",
        f"Description=roops loop {name} schedule",
        "",
        "[Timer]",
        f"Unit={service}",
    ]
    if "OnUnitActiveSec" in systemd_spec:
        # OnUnitActiveSec alone never fires until the service has run once —
        # launchd's StartInterval has no such gap. OnBootSec is the initial
        # trigger that closes it after a reboot.
        lines.append("OnBootSec=5min")
        lines.append(f"OnUnitActiveSec={systemd_spec['OnUnitActiveSec']}")
    calendars = systemd_spec.get("OnCalendar")
    if isinstance(calendars, str):
        calendars = [calendars]
    for cal in calendars or []:
        lines.append(f"OnCalendar={cal}")
    if calendars:
        # Catch up a firing missed while the host was down, mirroring launchd's
        # coalescing of calendar events missed during sleep.
        lines.append("Persistent=true")
    lines += ["", "[Install]", "WantedBy=timers.target"]
    return "\n".join(lines) + "\n"


def _systemd_write_units(root, name, conf):
    unit_dir = _systemd_unit_dir()
    os.makedirs(unit_dir, exist_ok=True)
    os.makedirs(os.path.join(root, "state", "launchd-logs"), exist_ok=True)
    sched = schedule.parse(conf["schedule"])
    service_path, timer_path = _systemd_unit_paths(name)
    with open(service_path, "w") as f:
        f.write(_render_systemd_service(name, root))
    with open(timer_path, "w") as f:
        f.write(_render_systemd_timer(name, sched["systemd"]))
    return timer_path


def _systemd_install(root, name, conf):
    """Write the units and arm the timer. Returns 0 on success, 1 on failure —
    the caller's own post-install verification poll is unchanged."""
    _systemd_write_units(root, name, conf)
    _service, timer = _systemd_unit_names(name)
    for args_list, what in (
        (["daemon-reload"], "daemon-reload"),
        (["enable", "--now", timer], "enable"),
    ):
        r = _systemctl(args_list)
        if r.returncode != 0:
            print(f"install failed: systemctl {what} error: {r.stderr.strip()}",
                  file=sys.stderr)
            return 1
    # The kickstart analogue: fire one run now so the verification poll below
    # has something fresh to find. --no-block because `start` on a Type=oneshot
    # otherwise waits for the entire engine run.
    service, _timer = _systemd_unit_names(name)
    r = _systemctl(["start", "--no-block", service])
    if r.returncode != 0:
        print(f"install failed: systemctl start error: {r.stderr.strip()}",
              file=sys.stderr)
        return 1
    return 0


def _systemd_uninstall(name):
    """Disarm and remove. Returns True iff unit files were actually removed."""
    _service, timer = _systemd_unit_names(name)
    _systemctl(["disable", "--now", timer])  # best-effort; not-armed is fine
    removed = False
    for path in _systemd_unit_paths(name):
        if os.path.isfile(path):
            os.remove(path)
            removed = True
    if removed:
        _systemctl(["daemon-reload"])
    return removed


def _systemd_set_enabled(name, enabled_value):
    """pause/resume: arm or disarm the timer, leaving the units in place."""
    _service, timer = _systemd_unit_names(name)
    verb = ["enable", "--now"] if enabled_value else ["disable", "--now"]
    return _systemctl(verb + [timer])


def unit_files_present(root, name):
    """File presence only, subprocess-free. launchd = plist; systemd = both units."""
    if _install_backend() == "systemd":
        service_path, timer_path = _systemd_unit_paths(name)
        return os.path.isfile(service_path) and os.path.isfile(timer_path)
    return os.path.isfile(_plist_path(root, name))


def scheduler_loaded(name):
    """Live check: launchctl print / systemctl is-enabled. Shells out via seams."""
    if _install_backend() == "systemd":
        _service, timer = _systemd_unit_names(name)
        return _systemctl(["is-enabled", timer]).returncode == 0
    uid = os.getuid()
    return _launchctl(["print", f"gui/{uid}/{_service_label(name)}"]).returncode == 0


def _systemd_is_installed(name):
    service_path, timer_path = _systemd_unit_paths(name)
    if not (os.path.isfile(service_path) and os.path.isfile(timer_path)):
        return False
    _service, timer = _systemd_unit_names(name)
    return _systemctl(["is-enabled", timer]).returncode == 0


def _plist_path(root, name):
    return os.path.join(root, "launchd", f"{_service_label(name)}.plist")


def _install_teardown(root, name):
    """Undo a failed or abandoned install, whichever backend performed it."""
    if _install_backend() == "systemd":
        _systemd_uninstall(name)
        return
    _launchctl(["bootout", f"gui/{os.getuid()}/{_service_label(name)}"])


def _is_installed(root, name):
    return unit_files_present(root, name) and scheduler_loaded(name)


def _host_timezone():
    path = os.environ.get("LOOPS_LOCALTIME_PATH", "/etc/localtime")
    try:
        target = os.readlink(path)
    except OSError:
        target = ""
    if "zoneinfo/" in target:
        return target.split("zoneinfo/", 1)[1]
    timedatectl = os.environ.get("LOOPS_TIMEDATECTL", "timedatectl")
    try:
        r = subprocess.run(
            [timedatectl, "show", "-p", "Timezone", "--value"],
            capture_output=True,
            text=True,
            check=False,
        )
        return (r.stdout or "").strip()
    except OSError:
        return ""


def _host_checks(root, run_user_dir=None):
    """systemd-only install-time host checks. Empty list = ok."""
    messages = []
    uid = os.getuid()
    user = os.environ.get("USER") or "unknown"

    loginctl = os.environ.get("LOOPS_LOGINCTL", "loginctl")
    linger_ok = False
    try:
        r = subprocess.run(
            [loginctl, "show-user", user, "-p", "Linger"],
            capture_output=True,
            text=True,
            check=False,
        )
        linger_ok = r.returncode == 0 and "Linger=yes" in (r.stdout or "")
    except OSError:
        linger_ok = False
    if not linger_ok:
        messages.append(
            f"linger is off for {user} — run: loginctl enable-linger {user} "
            "(timers die at logout without it)"
        )

    try:
        envf = loopconf.load_env(root)
    except loopconf.EnvFileError:
        envf = {}
    expect_tz = envf.get("LOOPS_EXPECT_TZ")
    if expect_tz:
        host_tz = _host_timezone()
        if host_tz != expect_tz:
            messages.append(
                f"host timezone is {host_tz}, fleet schedules are authored in {expect_tz} "
                "(LOOPS_EXPECT_TZ) — fix the host or the .env, then reinstall"
            )

    xdg = os.environ.get("XDG_RUNTIME_DIR")
    run_user = (
        run_user_dir
        or os.environ.get("LOOPS_RUN_USER_DIR")
        or f"/run/user/{uid}"
    )
    if not xdg and not os.path.isdir(run_user):
        messages.append(
            f"XDG_RUNTIME_DIR is unset and /run/user/{uid} does not exist — "
            f"systemctl --user cannot reach the bus; "
            f"export XDG_RUNTIME_DIR=/run/user/{uid}"
        )
    return messages


# ---------------------------------------------------------------------------
# loop.conf grammar-aware rewrite (§5.0) — used by pause/resume
# ---------------------------------------------------------------------------

_KEY_LINE_RE = re.compile(r"^([a-z][a-z0-9_]*)=")


def _rewrite_conf_key(path, key, new_value):
    """Rewrites a single KEY=value line in place, preserving every other
    line (including comments and blank lines) byte-for-byte. Uses the
    loop.conf KEY=value grammar's own key-matching rule (§5.0) — not a
    naive substring/sed replace — so it never touches a commented-out
    `# key=...` line or a value elsewhere in the file that happens to
    contain the key name."""
    with open(path, "r") as f:
        lines = f.readlines()
    out = []
    replaced = False
    for line in lines:
        stripped = line.rstrip("\n")
        m = _KEY_LINE_RE.match(stripped)
        if m and m.group(1) == key:
            out.append(f"{key}={new_value}\n")
            replaced = True
        else:
            out.append(line if line.endswith("\n") else line + "\n")
    if not replaced:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        out.append(f"{key}={new_value}\n")
    with open(path, "w") as f:
        f.writelines(out)


# ---------------------------------------------------------------------------
# §5.2 dangerous-combination checks
# ---------------------------------------------------------------------------

_BARE_TOOLS = {"gh", "git", "npm", "curl", "aws", "gcloud", "vercel", "wrangler", "supabase"}

# Prefix patterns of known mutating command forms. "*" matches any single
# token; otherwise the pattern token must appear as a substring of the
# corresponding entry token (covers verb-suffixed subcommands like
# `delete-bucket`, `create-user`).
_MUTATING_PREFIXES = [
    ("gh", "pr", "create"),
    ("gh", "pr", "merge"),
    ("gh", "release"),
    ("gh", "workflow", "run"),
    ("gh", "repo", "delete"),
    ("git", "push"),
    ("git", "commit"),
    ("git", "merge"),
    ("git", "rebase"),
    ("git", "reset"),
    ("npm", "publish"),
    ("npm", "install"),
    ("aws", "*", "delete"),
    ("aws", "*", "create"),
    ("aws", "*", "put"),
    ("aws", "*", "terminate"),
    ("gcloud", "*", "delete"),
    ("gcloud", "*", "create"),
    ("vercel", "deploy"),
    ("vercel", "remove"),
    ("wrangler", "deploy"),
    ("wrangler", "publish"),
    ("supabase", "db", "push"),
    ("supabase", "functions", "deploy"),
]


def _token_matches(tok, pat):
    # Rule-4 denylist is a substring heuristic and is non-exhaustive by
    # design: validate() is a lint/lint-adjacent warning layer, not the
    # enforcement boundary — actual mutation prevention comes from
    # credentials/sandboxing at the engine/permission-axis level.
    if pat == "*":
        return True
    return pat in tok


def _matches_prefix(tokens, pattern):
    if len(tokens) < len(pattern):
        return False
    return all(_token_matches(tok, pat) for tok, pat in zip(tokens, pattern))


def _entry_is_dangerous(entry):
    tokens = entry.strip().split()
    if not tokens:
        return True
    if len(tokens) == 1 and tokens[0] in _BARE_TOOLS:
        return True
    return any(_matches_prefix(tokens, pattern) for pattern in _MUTATING_PREFIXES)


def _dangerous_combo_checks(conf):
    errors = []
    perm_network = conf.get("perm_network")
    perm_local_exec = conf.get("perm_local_exec")
    perm_remote_mutation = conf.get("perm_remote_mutation")
    perm_fs_write = conf.get("perm_fs_write")
    exec_allowlist = conf.get("exec_allowlist") or []
    notes = conf.get("notes")
    i_accept = conf.get("i_accept_unrestricted")

    # Rule 1: perm_network=full AND perm_local_exec != none AND exec_allowlist empty/absent.
    if perm_network == "full" and perm_local_exec not in (None, "none") and not exec_allowlist:
        errors.append(
            "dangerous combo (rule 1): perm_network=full with perm_local_exec="
            f"{perm_local_exec!r} requires a non-empty exec_allowlist"
        )

    # Rule 2: perm_remote_mutation != none without remote_mutation_justification.
    if perm_remote_mutation and perm_remote_mutation != "none" and not conf.get(
        "remote_mutation_justification"
    ):
        errors.append(
            "dangerous combo (rule 2): perm_remote_mutation="
            f"{perm_remote_mutation!r} requires a non-empty remote_mutation_justification"
        )

    # Rule 3: perm_local_exec=full AND perm_network=full without the explicit override.
    if perm_local_exec == "full" and perm_network == "full" and not i_accept:
        errors.append(
            "dangerous combo (rule 3): perm_local_exec=full and perm_network=full "
            "requires i_accept_unrestricted=true"
        )

    # Rule 4: exec_allowlist entries must be command-scoped, not bare tool names or
    # known mutating forms.
    for entry in exec_allowlist:
        if _entry_is_dangerous(entry):
            errors.append(
                f"dangerous combo (rule 4): exec_allowlist entry {entry!r} is a bare "
                "tool name or a mutating command form — must be a scoped read form"
            )

    # Rule 5: perm_fs_write=workdir without notes.
    if perm_fs_write == "workdir" and not notes:
        errors.append(
            "dangerous combo (rule 5): perm_fs_write=workdir requires notes explaining why"
        )

    # Rule 7 (contract amendment): engine=codex AND perm_network=full AND
    # perm_fs_write != workdir. codex cannot grant network under a read-only
    # sandbox (§7.2) — network=full requires workspace-write, which is only
    # ever selected by perm_fs_write=workdir. Not a permission-escalation risk
    # like rules 1-6, but a config contradiction: this combo can never do
    # anything, since the adapter has no read-only+network mode to map it to.
    if conf.get("engine") == "codex" and perm_network == "full" and perm_fs_write != "workdir":
        errors.append(
            "dangerous combo (rule 7): network=full on codex requires perm_fs_write=workdir"
        )

    # Rule 8 (§5 credential_env): reserved, not implemented in v1 — hard-fail any
    # non-empty value rather than silently accepting a config that promises
    # credential passthrough the harness does not actually provide.
    if conf.get("credential_env"):
        errors.append(
            "dangerous combo (rule 8): credential_env is reserved and not implemented "
            "in v1 — remove it"
        )

    return errors


def _validate_one(root, from_dir, name):
    loop_dir = os.path.join(root, from_dir, name)
    conf_path = os.path.join(loop_dir, "loop.conf")
    if not os.path.isfile(conf_path):
        return [f"loop.conf not found at {conf_path}"]

    conf, parse_errors = loopconf.parse(conf_path)
    errors = [f"loopconf: {e}" for e in parse_errors]

    # Rule 6 (part): name must equal directory name.
    conf_name = conf.get("name")
    if conf_name and conf_name != name:
        errors.append(
            f"dangerous combo (rule 6): name={conf_name!r} does not match directory name {name!r}"
        )

    errors += _dangerous_combo_checks(conf)

    # Rule 6 (part): watchdog requires an executable precheck.sh.
    if conf.get("type") == "watchdog":
        precheck = os.path.join(loop_dir, "precheck.sh")
        if not (os.path.isfile(precheck) and os.access(precheck, os.X_OK)):
            errors.append(
                "dangerous combo (rule 6): type=watchdog requires an executable precheck.sh"
            )

    # Amendment 2: an optional render.sh makes the loop page-enabled — but only
    # when executable; present-and-inert is always a mistake worth failing loudly.
    render_sh = os.path.join(loop_dir, "render.sh")
    if os.path.isfile(render_sh) and not os.access(render_sh, os.X_OK):
        errors.append("render.sh present but not executable")

    # Rule 6 (part): engine adapter must exist. Resolved under --root (engines/ is
    # produced by a concurrently-built task, never under this script's own dir).
    engine = conf.get("engine")
    if engine:
        adapter = os.path.join(root, "engines", f"{engine}.sh")
        if not os.path.isfile(adapter):
            errors.append(f"dangerous combo (rule 6): engine adapter missing: engines/{engine}.sh")

    # §8 addition: prompt.md must document Finding identity.
    prompt_path = os.path.join(loop_dir, "prompt.md")
    if not os.path.isfile(prompt_path):
        errors.append("prompt.md not found")
    else:
        with open(prompt_path, "r") as f:
            prompt_text = f.read()
        if "## Finding identity" not in prompt_text:
            errors.append("prompt.md missing required '## Finding identity' heading")

    # §8 addition: SPEC.md must have no remaining [FILL: ...] placeholders.
    spec_path = os.path.join(loop_dir, "SPEC.md")
    if not os.path.isfile(spec_path):
        errors.append("SPEC.md not found")
    else:
        with open(spec_path, "r") as f:
            spec_text = f.read()
        if "[FILL:" in spec_text:
            errors.append("SPEC.md still contains [FILL: ...] placeholder(s)")

    return errors


# ---------------------------------------------------------------------------
# Table / output helpers
# ---------------------------------------------------------------------------

def _print_table(rows, columns):
    if not rows:
        print("(none)")
        return
    str_rows = [{c: "" if r.get(c) is None else str(r.get(c)) for c in columns} for r in rows]
    widths = {c: max(len(c), max(len(r[c]) for r in str_rows)) for c in columns}
    print("  ".join(c.ljust(widths[c]) for c in columns))
    print("  ".join("-" * widths[c] for c in columns))
    for r in str_rows:
        print("  ".join(r[c].ljust(widths[c]) for c in columns))


def _discover_loop_names(root, from_dir):
    base = os.path.join(root, from_dir)
    if not os.path.isdir(base):
        return []
    names = []
    for entry in sorted(os.listdir(base)):
        if os.path.isfile(os.path.join(base, entry, "loop.conf")):
            names.append(entry)
    return names


def _write_file(path, content):
    with open(path, "w") as f:
        f.write(content)


_REQUIRES_COMMENT = (
    "# requires=   # host needs: os:linux|darwin, bin:<name>, file:<path>, "
    "env:<KEY>, probe:<name>\n"
)


def _insert_requires_comment(conf_path):
    """Emit the commented requires= hint after tags (or notes) in a scaffold."""
    if not os.path.isfile(conf_path):
        return
    with open(conf_path, "r") as f:
        text = f.read()
    if "# requires=" in text:
        return
    lines = text.splitlines(keepends=True)
    insert_at = None
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("tags=") or stripped.startswith("# tags="):
            insert_at = i + 1
    if insert_at is None:
        for i, line in enumerate(lines):
            stripped = line.strip()
            if stripped.startswith("notes=") or stripped.startswith("# notes="):
                insert_at = i + 1
    if insert_at is None:
        insert_at = len(lines)
    lines.insert(insert_at, _REQUIRES_COMMENT)
    with open(conf_path, "w") as f:
        f.writelines(lines)


def _merged_env(root):
    env = dict(os.environ)
    for k, v in loopconf.load_env(root).items():
        env.setdefault(k, v)
    return env


def _requirement_results(root, from_dir, name, *, live):
    conf_path = os.path.join(root, from_dir, name, "loop.conf")
    if not os.path.isfile(conf_path):
        return []
    conf, _errors = loopconf.parse(conf_path)
    env = _merged_env(root)
    return requirements.check(root, conf, live=live, env=env)


def _unmet_requirements(root, from_dir, name, *, live):
    return [
        (item, detail)
        for item, ok, detail in _requirement_results(root, from_dir, name, live=live)
        if not ok
    ]


def _refuse_unmet(verb, name, unmet):
    for item, detail in unmet:
        print(
            f"refusing to {verb} {name}: requirement unmet — {item} ({detail})",
            file=sys.stderr,
        )


# ---------------------------------------------------------------------------
# Scaffold templates (§8 "loopctl new scaffolding")
#
# The template text itself lives in bin/skill_import.py (Amendment 2,
# 2026-07-30) — `skill_import.apply()` needs the exact same SPEC.md/prompt.md/
# precheck.sh frame `loopctl new` uses, so the strings have a single home and
# both call sites reference it rather than drifting apart. These names are
# kept as local aliases purely so `cmd_new` below doesn't need touching.
# ---------------------------------------------------------------------------

_LOOP_CONF_TEMPLATE = skill_import._LOOP_CONF_TEMPLATE
_PROMPT_MD_TEMPLATE = skill_import._PROMPT_MD_TEMPLATE
_SPEC_MD_TEMPLATE = skill_import._SPEC_MD_TEMPLATE
_PRECHECK_SH_TEMPLATE = skill_import._PRECHECK_SH_TEMPLATE
_render_template = skill_import._render_template


# ---------------------------------------------------------------------------
# launchd plist generation
# ---------------------------------------------------------------------------

_runtime_path = requirements.runtime_path


def _plist_dict(root, name, conf):
    label = _service_label(name)
    run_loop_sh = os.path.abspath(os.path.join(root, "bin", "run-loop.sh"))
    log_dir = os.path.abspath(os.path.join(root, "state", "launchd-logs"))
    home = os.environ.get("HOME", os.path.expanduser("~"))
    path_val = _runtime_path(home)
    d = {
        "Label": label,
        "ProgramArguments": ["/bin/bash", run_loop_sh, name, "--trigger", "launchd"],
        "WorkingDirectory": os.path.abspath(root),
        "EnvironmentVariables": {
            "HOME": home,
            "PATH": path_val,
            "LOOPS_ROOT": os.path.abspath(root),
        },
        "StandardOutPath": os.path.join(log_dir, f"{name}.out.log"),
        "StandardErrorPath": os.path.join(log_dir, f"{name}.err.log"),
    }
    sched = schedule.parse(conf["schedule"])
    d.update(sched["launchd"])
    return d


def _render_plist_xml(root, name, conf):
    return plistlib.dumps(_plist_dict(root, name, conf), fmt=plistlib.FMT_XML)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_new(args):
    loop_dir = os.path.join(args.root, args.from_dir, args.name)
    if os.path.exists(loop_dir):
        print(f"refusing to scaffold {args.name}: {loop_dir} already exists", file=sys.stderr)
        return 1
    if not loopconf.NAME_RE.match(args.name):
        print(
            f"invalid loop name {args.name!r}: must match ^[a-z][a-z0-9-]{{1,40}}$",
            file=sys.stderr,
        )
        return 2
    owner = args.owner or loopconf.DEFAULT_OWNER
    if not loopconf.NAME_RE.match(owner):
        print(
            f"invalid owner {owner!r}: must match ^[a-z][a-z0-9-]{{1,40}}$",
            file=sys.stderr,
        )
        return 2

    os.makedirs(loop_dir)
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")

    conf_path = os.path.join(loop_dir, "loop.conf")
    _write_file(
        conf_path,
        _render_template(
            _LOOP_CONF_TEMPLATE, args.name, type=args.type_, engine=args.engine, date=today, owner=owner
        ),
    )
    _insert_requires_comment(conf_path)
    _write_file(os.path.join(loop_dir, "prompt.md"), _render_template(_PROMPT_MD_TEMPLATE, args.name))
    _write_file(os.path.join(loop_dir, "SPEC.md"), _render_template(_SPEC_MD_TEMPLATE, args.name))
    _write_file(os.path.join(loop_dir, "dashboard.json"), '{"panels": []}\n')
    precheck_path = os.path.join(loop_dir, "precheck.sh")
    _write_file(precheck_path, _render_template(_PRECHECK_SH_TEMPLATE, args.name))
    os.chmod(precheck_path, 0o755)

    _record_event(
        args.root, args.name, "created", args.actor, detail={"type": args.type_, "engine": args.engine}
    )

    files = ["loop.conf", "prompt.md", "SPEC.md", "dashboard.json", "precheck.sh"]
    if args.json:
        print(json.dumps({"name": args.name, "dir": loop_dir, "files": files}))
    else:
        print(f"scaffolded {args.name} at {loop_dir}")
    return 0


def cmd_validate(args):
    if args.name and args.all:
        print("specify either <name> or --all, not both", file=sys.stderr)
        return 2
    if not args.name and not args.all:
        print("specify <name> or --all", file=sys.stderr)
        return 2

    names = _discover_loop_names(args.root, args.from_dir) if args.all else [args.name]

    results = {}
    notices = {}
    any_fail = False
    for name in names:
        errors = _validate_one(args.root, args.from_dir, name)
        results[name] = errors
        notices[name] = _owner_notices(args.root, args.from_dir, name) + _requirement_notices(
            args.root, args.from_dir, name
        )
        if errors:
            any_fail = True

    if args.json:
        print(
            json.dumps(
                {
                    n: {"ok": not e, "errors": e, "notices": notices[n]}
                    for n, e in results.items()
                }
            )
        )
    else:
        for name, errors in results.items():
            if errors:
                print(f"FAIL {name}")
                for e in errors:
                    print(f"  - {e}")
            else:
                print(f"OK {name}")
            for note in notices[name]:
                print(f"  note: {note}")

    return 1 if any_fail else 0


def _owner_notices(root, from_dir, name):
    """B-17: non-fatal notices — an assumed owner is worth saying, never
    worth failing (owner is required-but-assumed, §5). Notices never touch
    the exit code."""
    conf_path = os.path.join(root, from_dir, name, "loop.conf")
    if not os.path.isfile(conf_path):
        return []
    conf, _errors = loopconf.parse(conf_path)
    _owner, assumed = loopconf.resolve_owner(conf)
    if assumed:
        return [
            f"owner assumed {loopconf.DEFAULT_OWNER!r} — set owner= in loop.conf "
            f"or run `loopctl set-owner {name} <owner>`"
        ]
    return []


def _requirement_notices(root, from_dir, name):
    """Non-fatal: a valid loop can still be unrunnable on this host."""
    conf_path = os.path.join(root, from_dir, name, "loop.conf")
    if not os.path.isfile(conf_path):
        return []
    conf, errors = loopconf.parse(conf_path)
    if errors:
        return []
    try:
        env = _merged_env(root)
    except loopconf.EnvFileError:
        return []
    results = requirements.check(root, conf, live=True, env=env)
    return [
        f"requirement unmet on this host: {item} — {detail}"
        for item, ok, detail in results
        if not ok
    ]


def cmd_requirements(args):
    names = list(args.loop_names) if args.loop_names else _discover_loop_names(
        args.root, args.from_dir
    )
    live = not getattr(args, "no_live", False)
    as_json = bool(getattr(args, "json", False))
    payload = {}
    any_unmet = False
    any_missing = False
    for name in names:
        conf_path = os.path.join(args.root, args.from_dir, name, "loop.conf")
        if not os.path.isfile(conf_path):
            print(f"loop not found: {name}", file=sys.stderr)
            any_missing = True
            continue
        try:
            results = _requirement_results(args.root, args.from_dir, name, live=live)
        except loopconf.EnvFileError as e:
            print(str(e), file=sys.stderr)
            return 2
        items = [
            {"item": item, "ok": ok, "detail": detail} for item, ok, detail in results
        ]
        ok = all(row["ok"] for row in items)
        if not ok:
            any_unmet = True
        payload[name] = {"ok": ok, "items": items}
        if as_json:
            continue
        if not items:
            print(f"OK {name} (no requirements declared)")
            continue
        print(f"{'OK' if ok else 'UNMET'} {name}")
        for row in items:
            if row["ok"]:
                print(f"  + {row['item']}")
            else:
                print(f"  - {row['item']}: {row['detail']}")
    if as_json:
        print(json.dumps(payload))
    if any_missing:
        return 2
    return 1 if any_unmet else 0


def cmd_run(args):
    runner = os.path.join(args.root, "bin", "run-loop.sh")
    if not os.path.isfile(runner):
        print(f"run-loop.sh not found at {runner}", file=sys.stderr)
        return 1
    cmd = ["bash", runner, args.name, "--trigger", args.trigger, "--from", args.from_dir]
    env = {**os.environ, "LOOPS_ROOT": str(args.root)}
    proc = subprocess.run(cmd, env=env, check=False)
    return proc.returncode


def cmd_list(args):
    names = _discover_loop_names(args.root, args.from_dir)
    rows = []
    for name in names:
        conf_path = os.path.join(args.root, args.from_dir, name, "loop.conf")
        conf, _errors = loopconf.parse(conf_path)
        owner, owner_assumed = loopconf.resolve_owner(conf)
        rows.append(
            {
                "name": name,
                "owner": owner,
                "owner_assumed": owner_assumed,
                "type": conf.get("type"),
                "engine": conf.get("engine"),
                "schedule": conf.get("schedule"),
                "enabled": conf.get("enabled"),
                "installed": _is_installed(args.root, name),
                "tags": conf.get("tags") or [],
            }
        )
    total = len(rows)
    if args.tag:
        rows = [r for r in rows if args.tag in r["tags"]]
    if args.owner:
        # Exact match on the RESOLVED owner (assumed rows match their
        # default), mirroring --tag's no-substring rule.
        rows = [r for r in rows if r["owner"] == args.owner]
    if args.json:
        print(json.dumps(rows))
    else:
        if not rows:
            # Fix wave (2026-07-30, IMPORTANT #1): a genuinely empty
            # loops.d/examples and "zero loops matched --tag" are different
            # claims -- the old code printed the genuinely-empty message in
            # BOTH cases, which is a false statement about a non-empty fleet
            # when a --tag filter simply had no match (contradicts
            # docs/INTERFACES.md's own "zero loops under --from" wording).
            active_filters = []
            if args.tag:
                active_filters.append(f"--tag {args.tag}")
            if args.owner:
                active_filters.append(f"--owner {args.owner}")
            if active_filters and total:
                print(
                    f"0 loops matching {' '.join(active_filters)} "
                    f"({total} loops under {args.from_dir})"
                )
            else:
                print(f"0 loops ({args.from_dir} empty)")
        else:
            table_rows = [{**r, "tags": ",".join(r["tags"])} for r in rows]
            _print_table(
                table_rows,
                ["name", "owner", "type", "engine", "schedule", "enabled", "installed", "tags"],
            )
    return 0


def _is_terminal_run_row(row):
    """(Amendment 2 — 2026-07-30) A run row counts as "terminal" — safe to use
    for the displayed status/headline — when it has finished (`finished_at`
    set) and isn't a `skipped-overlap` placeholder. `skipped-overlap` rows are
    finished immediately but never carry real status/headline data, so a
    naive "newest row" lookup blanks the display the instant an overlap skip
    (or a still-running row) becomes the newest row for a loop."""
    return (
        bool(row)
        and row.get("finished_at") is not None
        and row.get("runner_status") != "skipped-overlap"
    )


def _resolve_display_row(root, name, last):
    """Given `last` (the newest run row for `name`, or None), return the row
    to use for displayed status/headline: `last` itself if terminal,
    otherwise the newest row among the last 10 that IS terminal, otherwise
    None (every recent attempt was skipped-overlap or still running)."""
    if _is_terminal_run_row(last):
        return last
    for row in _db_query(root, "last-runs", loop=name, limit=10):
        if _is_terminal_run_row(row):
            return row
    return None


def _loop_health(dash, conf, last, now):
    """The dashboard's own `_resolve_loop` health formula (dashboard/generate.py
    ~:1275-1323), reapplied here on the RAW latest run row — never the
    blanking-fix's fallback-resolved row (Amendment 2 — 2026-07-30 fix
    round 1: "the dashboard is canonical" ruling — an agent must see the
    same fleet health a human sees on the dashboard). Reuses the dashboard's
    own primitives (`is_died`/`is_stale`/`compute_light`/`is_overdue`) rather
    than reimplementing their logic; only the branching glue is duplicated,
    because `_resolve_loop` itself also does unrelated page-assembly work
    (sqlite reads, tags, provenance) `loopctl` has no reason to repeat.
    Returns `(light_color, needs_attention)` — `light_color` in
    `{"green","amber","red","grey"}`, matching `dashboard/generate.py`'s own
    vocabulary exactly, including that a `skipped-overlap`/`skipped-precheck`
    row is unconditionally amber even if the prior run was `ok`."""
    timeout_s = conf.get("timeout_s", 900)
    schedule_spec = conf.get("schedule", "manual")
    try:
        expected_interval_s = schedule.parse(schedule_spec).get("expected_interval_s", 0)
    except Exception:  # noqa: BLE001 — a bad schedule must degrade, never crash `status`
        expected_interval_s = 0

    died = False
    if last is not None:
        died = dash.is_died(last.get("finished_at"), last.get("started_at"), timeout_s, now)

    stale = False
    if last is not None and not died:
        stale = dash.is_stale(last.get("started_at"), expected_interval_s, now)

    if died:
        light_color = "red"
    elif last is not None and last.get("finished_at") is None:
        fin, st = last.get("finished_at"), last.get("started_at")
        light_color = "amber" if dash.is_overdue(fin, st, timeout_s, now) else "grey"
    elif last is not None:
        light_color, _marker = dash.compute_light(last.get("runner_status"), last.get("effective_status"))
    else:
        light_color = "grey"

    needs_attention = (light_color in ("amber", "red")) or stale or died
    return light_color, needs_attention


def _fleet_aggregate(root, from_dir):
    """`fleet: N loops · ok X · warn Y · alert Z · needs_attention W ·
    spend7d $S` — the leading line on `status` and the bare-invocation
    summary (Amendment 2 — 2026-07-30). Loop count comes from the loops.d/
    (or examples/) directory; `ok`/`warn`/`alert` map `_loop_health`'s
    green/amber/red 1:1 (grey — never run, or a still-running run within its
    own timeout budget — is counted toward `N` but not toward any of the
    three); `needs_attention` is `_loop_health`'s own boolean, so it agrees
    with the dashboard exactly, including staleness and the harness-died
    case, neither of which `ok`/`warn`/`alert` alone would catch. `spend7d`
    sums `cost_usd` across `db.py query spend --days 7`. Status data comes
    from one `db.py query loops-summary` call for the whole fleet (one row
    per loop: its newest run, RAW — not the blanking-fix's fallback-resolved
    row, which is for the per-loop status/headline TEXT only, see
    `_resolve_display_row`)."""
    dash = _dashboard_module()
    now = datetime.now(timezone.utc)
    names = _discover_loop_names(root, from_dir)
    summary_by_loop = {r["loop_name"]: r for r in _db_query(root, "loops-summary")}

    ok = warn = alert = needs_attention = 0
    for name in names:
        last = summary_by_loop.get(name)
        if last is None:
            continue  # never run — not yet actionable, doesn't count as needing attention
        conf_path = os.path.join(root, from_dir, name, "loop.conf")
        conf, _errors = loopconf.parse(conf_path)
        light_color, loop_needs_attention = _loop_health(dash, conf, last, now)
        if light_color == "green":
            ok += 1
        elif light_color == "amber":
            warn += 1
        elif light_color == "red":
            alert += 1
        # grey: uncounted in ok/warn/alert, matching the dashboard's own grey bucket
        if loop_needs_attention:
            needs_attention += 1

    spend_rows = _db_query(root, "spend", days=7)
    spend7d = round(float(sum((r.get("cost_usd") or 0) for r in spend_rows)), 2)

    return {
        "loops": len(names),
        "ok": ok,
        "warn": warn,
        "alert": alert,
        "needs_attention": needs_attention,
        "spend7d": spend7d,
    }


def _format_fleet_line(fleet):
    return (
        f"fleet: {fleet['loops']} loops · ok {fleet['ok']} · warn {fleet['warn']} · "
        f"alert {fleet['alert']} · needs_attention {fleet['needs_attention']} · "
        f"spend7d ${fleet['spend7d']:.2f}"
    )


def cmd_status(args):
    dash = _dashboard_module()
    now = datetime.now(timezone.utc)
    names = [args.name] if args.name else _discover_loop_names(args.root, args.from_dir)

    rows = []
    for name in names:
        conf_path = os.path.join(args.root, args.from_dir, name, "loop.conf")
        conf, _errors = loopconf.parse(conf_path)
        last_runs = _db_query(args.root, "last-runs", loop=name, limit=1)
        last = last_runs[0] if last_runs else None
        display = _resolve_display_row(args.root, name, last)
        in_flight = bool(last) and last.get("finished_at") is None

        next_text = "—"
        sched_spec = conf.get("schedule")
        if sched_spec:
            next_dt = dash.next_run_estimate(
                sched_spec, last["started_at"] if last else None, now
            )
            if next_dt:
                next_text = dash.format_relative(next_dt.strftime("%Y-%m-%dT%H:%M:%SZ"), now)

        ev = _db_query(
            args.root, "loop-events", loop=name, events="created,imported", limit=1
        )
        prov = ev[0] if ev else None
        provenance = (
            {"event": prov["event"], "actor": prov["actor"], "ts": prov["ts"]}
            if prov
            else None
        )

        owner, owner_assumed = loopconf.resolve_owner(conf)
        rows.append(
            {
                "name": name,
                "owner": owner,
                "owner_assumed": owner_assumed,
                "runner_status": display.get("runner_status") if display else None,
                "effective_status": display.get("effective_status") if display else None,
                "headline": display.get("headline") if display else None,
                "started_at": display.get("started_at") if display else None,
                "next_run": next_text,
                "tags": conf.get("tags") or [],
                "provenance": provenance,
                "in_flight": in_flight,
            }
        )

    fleet = _fleet_aggregate(args.root, args.from_dir)

    if args.json:
        print(json.dumps({"fleet": fleet, "loops": rows}))
    else:
        print(_format_fleet_line(fleet))
        if not rows:
            print(f"0 loops ({args.from_dir} empty)")
        else:
            _print_table(
                rows,
                ["name", "runner_status", "effective_status", "headline", "started_at", "next_run"],
            )
    return 0


_RUNNER_FAILURE_STATUSES = {
    "precheck-failed",
    "engine-failed",
    "engine-timeout",
    "auth-failed",
    "tool-denied",
    "contract-violation",
    "harness-error",
}


def cmd_install(args):
    root, name = args.root, args.name
    if args.from_dir != "loops.d":
        # §1: examples/<name>/ are pilot fixtures and are NEVER installed to launchd.
        print(f"refusing to install {name}: --from {args.from_dir} is never installed (loops.d only)",
              file=sys.stderr)
        return 1
    conf_path = os.path.join(root, args.from_dir, name, "loop.conf")
    if not os.path.isfile(conf_path):
        print(f"loop not found: {name}", file=sys.stderr)
        return 1

    conf, _parse_errors = loopconf.parse(conf_path)
    if conf.get("schedule") == "manual":
        print(f"refusing to install {name}: schedule=manual is never installed", file=sys.stderr)
        return 1

    errors = _validate_one(root, args.from_dir, name)
    if errors:
        print(f"refusing to install {name}: fails validate", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    try:
        unmet = _unmet_requirements(root, args.from_dir, name, live=True)
    except loopconf.EnvFileError as e:
        print(f"refusing to install {name}: {e}", file=sys.stderr)
        return 1
    if unmet:
        _refuse_unmet("install", name, unmet)
        return 1

    # Amendment 2 (2026-07-30): install requires a prior non-failed supervised
    # run to already exist — makes the documented validate -> supervised run ->
    # install gauntlet mechanical rather than advisory. Applies to ALL loops,
    # not only imported ones. Note this checks EXISTING run rows already in
    # the db (e.g. from `loopctl run`), independent of the post-kickstart
    # freshness poll further down, which verifies a NEW run after this install.
    ok_runs = [r for r in _db_query(root, "last-runs", loop=name, limit=50)
               if r.get("runner_status") in ("completed", "skipped-precheck")]
    if not ok_runs:
        print(f"refusing to install {name}: no non-failed supervised run recorded — "
              f"run 'loopctl run {name}' first", file=sys.stderr)
        return 1

    label = _service_label(name)
    log_dir = os.path.join(root, "state", "launchd-logs")
    os.makedirs(log_dir, exist_ok=True)
    uid = os.getuid()
    before_run_id = _latest_run_id(root, name)

    if _install_backend() == "systemd":
        host_msgs = _host_checks(root)
        if host_msgs:
            for msg in host_msgs:
                print(f"refusing to install: {msg}", file=sys.stderr)
            return 1
        if _systemd_install(root, name, conf) != 0:
            return 1
        installed_path = _systemd_unit_paths(name)[1]
    else:
        launchd_dir = os.path.join(root, "launchd")
        os.makedirs(launchd_dir, exist_ok=True)
        plist_path = _plist_path(root, name)
        installed_path = plist_path

        with open(plist_path, "wb") as f:
            f.write(_render_plist_xml(root, name, conf))

        _launchctl(["bootout", f"gui/{uid}/{label}"])  # ignore failure — not yet installed is fine

        r = _launchctl(["bootstrap", f"gui/{uid}", plist_path])
        if r.returncode != 0:
            print(f"install failed: launchctl bootstrap error: {r.stderr.strip()}", file=sys.stderr)
            return 1

        r = _launchctl(["kickstart", "-p", f"gui/{uid}/{label}"])
        if r.returncode != 0:
            print(f"install failed: launchctl kickstart error: {r.stderr.strip()}", file=sys.stderr)
            _launchctl(["bootout", f"gui/{uid}/{label}"])
            return 1

    # db.py start-run writes a transient runner_status="started" row BEFORE
    # the engine actually runs (§4.1 step 3) — the row for a fresh run_id
    # only reflects the real outcome once finish-run sets finished_at. So we
    # must poll past "fresh" all the way to "fresh AND terminal" before
    # trusting runner_status; a fresh row that never leaves "started" within
    # the budget is a verification failure in its own right (engine likely
    # hung or never got invoked), not a pass.
    timeout_s = float(os.environ.get("LOOPCTL_INSTALL_POLL_TIMEOUT_S", "90"))
    interval_s = float(os.environ.get("LOOPCTL_INSTALL_POLL_INTERVAL_S", "1"))
    deadline = time.monotonic() + timeout_s
    verified = False
    fresh_row = None
    while True:
        rows = _db_query(root, "last-runs", loop=name, limit=1)
        if rows:
            row = rows[0]
            if row.get("run_id") != before_run_id:
                fresh_row = row
                if row.get("finished_at"):
                    # Terminal: apply the non-failed-status check now.
                    verified = row.get("runner_status") not in _RUNNER_FAILURE_STATUSES
                    break
        if time.monotonic() >= deadline:
            break
        time.sleep(interval_s)

    if not verified:
        backend = _install_backend()
        if fresh_row is not None and not fresh_row.get("finished_at"):
            print(
                f"install failed: fresh run recorded for {name} but never reached a "
                f"terminal state (stuck in runner_status={fresh_row.get('runner_status')!r}) "
                f"within {timeout_s:.0f}s after the install trigger — check the engine process "
                f"under the scheduler ({backend})",
                file=sys.stderr,
            )
        else:
            print(
                f"install failed: no fresh non-failed run recorded for {name} within "
                f"{timeout_s:.0f}s after the install trigger — check engine auth/env "
                f"under the scheduler ({backend})",
                file=sys.stderr,
            )
        _install_teardown(root, name)
        return 1

    _record_event(root, name, "installed", args.actor)
    print(f"installed {name} -> {installed_path}")
    return 0


def cmd_uninstall(args):
    root, name = args.root, args.name
    if _install_backend() == "systemd":
        removed = _systemd_uninstall(name)
        unit_word = "unit"
    else:
        label = _service_label(name)
        uid = os.getuid()
        _launchctl(["bootout", f"gui/{uid}/{label}"])  # best-effort; ignore failure
        plist_path = _plist_path(root, name)
        removed = False
        if os.path.isfile(plist_path):
            os.remove(plist_path)
            removed = True
        unit_word = "plist"
    _record_event(root, name, "uninstalled", args.actor)
    suffix = "" if removed else f" (no {unit_word} was present)"
    print(f"uninstalled {name}{suffix}")
    return 0


def _set_enabled(args, enabled_value):
    root, name = args.root, args.name
    conf_path = os.path.join(root, args.from_dir, name, "loop.conf")
    if not os.path.isfile(conf_path):
        print(f"loop not found: {name}", file=sys.stderr)
        return 1

    if enabled_value:
        try:
            unmet = _unmet_requirements(root, args.from_dir, name, live=True)
        except loopconf.EnvFileError as e:
            print(f"refusing to resume {name}: {e}", file=sys.stderr)
            return 1
        if unmet:
            _refuse_unmet("resume", name, unmet)
            return 1

    _rewrite_conf_key(conf_path, "enabled", "true" if enabled_value else "false")

    if _install_backend() == "systemd":
        # Arm/disarm the timer, leaving the units on disk: pause is not
        # uninstall, and the dashboard still needs to see it installed.
        if os.path.isfile(_systemd_unit_paths(name)[1]):
            _systemd_set_enabled(name, enabled_value)
    else:
        label = _service_label(name)
        plist_path = _plist_path(root, name)
        uid = os.getuid()
        if os.path.isfile(plist_path):
            if enabled_value:
                _launchctl(["bootstrap", f"gui/{uid}", plist_path])
            else:
                _launchctl(["bootout", f"gui/{uid}/{label}"])

    verb = "resumed" if enabled_value else "paused"
    _record_event(root, name, verb, args.actor)
    print(f"{verb} {name}")
    return 0


def cmd_pause(args):
    return _set_enabled(args, False)


def cmd_resume(args):
    return _set_enabled(args, True)


def _apply_schedule(root, from_dir, name, spec):
    """Validates `spec` against the §5.1 grammar, rewrites loop.conf's
    `schedule` key, and — if the loop is installed (a plist exists) —
    re-renders the plist to match. Never kickstarts: rescheduling must not
    fire a run. `spec == "manual"` uninstalls (bootout + remove plist)
    instead of re-rendering, matching install's own refusal to ever install
    a manual-scheduled loop."""
    conf_path = os.path.join(root, from_dir, name, "loop.conf")
    if not os.path.isfile(conf_path):
        raise ValueError(f"loop not found: {name}")
    schedule.parse(spec)  # raises ValueError on bad grammar — validate BEFORE any write
    if spec != "manual":
        try:
            unmet = _unmet_requirements(root, from_dir, name, live=True)
        except loopconf.EnvFileError as e:
            raise ValueError(str(e)) from e
        if unmet:
            _refuse_unmet("set-schedule", name, unmet)
            raise ValueError(
                "requirement unmet — "
                + "; ".join(f"{item} ({detail})" for item, detail in unmet)
            )
    conf, _errors = loopconf.parse(conf_path)
    old_spec = conf.get("schedule", "")
    _rewrite_conf_key(conf_path, "schedule", spec)

    if _install_backend() == "systemd":
        _service_unit, timer_unit = _systemd_unit_names(name)
        if os.path.isfile(_systemd_unit_paths(name)[1]):
            if spec == "manual":
                _systemd_uninstall(name)
            else:
                conf, _errors = loopconf.parse(conf_path)  # re-read: schedule now updated
                _systemd_write_units(root, name, conf)
                _systemctl(["daemon-reload"])
                if str(conf.get("enabled", "true")).lower() != "false":
                    # restart re-arms the TIMER with the new schedule. It does
                    # not start the service, so rescheduling still fires no run.
                    _systemctl(["restart", timer_unit])
        return old_spec, spec

    label = _service_label(name)
    plist_path = _plist_path(root, name)
    uid = os.getuid()
    if os.path.isfile(plist_path):
        if spec == "manual":
            _launchctl(["bootout", f"gui/{uid}/{label}"])  # best-effort
            os.remove(plist_path)
        else:
            conf, _errors = loopconf.parse(conf_path)  # re-read: schedule now updated
            with open(plist_path, "wb") as f:
                f.write(_render_plist_xml(root, name, conf))
            if str(conf.get("enabled", "true")).lower() != "false":
                _launchctl(["bootout", f"gui/{uid}/{label}"])
                _launchctl(["bootstrap", f"gui/{uid}", plist_path])
                # NO kickstart — rescheduling must never fire a run.

    return old_spec, spec


def cmd_set_schedule(args):
    try:
        old, new = _apply_schedule(args.root, args.from_dir, args.name, args.spec)
    except ValueError as exc:
        print(f"set-schedule failed: {exc}", file=sys.stderr)
        return 1

    try:
        dash = _dashboard_module()
        dash.generate(root=args.root, loopconf_parse=loopconf.parse, schedule_parse=schedule.parse)
    except Exception as e:  # noqa: BLE001 — dashboard regen is best-effort; the schedule change itself succeeded
        print(f"warning: dashboard regen failed: {e}", file=sys.stderr)

    print(f"schedule {args.name}: {old or '(unset)'} -> {new}")
    return 0


def cmd_set_owner(args):
    """B-17: the set-schedule shape minus every launchd concern — owner is
    not in the plist. Validate BEFORE any write; dashboard regen is
    best-effort; no loop_events row (loops.d/ is git-tracked — git history
    is the audit trail, same as set-schedule)."""
    conf_path = os.path.join(args.root, args.from_dir, args.name, "loop.conf")
    if not os.path.isfile(conf_path):
        print(f"loop not found: {args.name}", file=sys.stderr)
        return 1
    if not loopconf.NAME_RE.match(args.owner):
        print(
            f"invalid owner {args.owner!r}: must match ^[a-z][a-z0-9-]{{1,40}}$",
            file=sys.stderr,
        )
        return 2

    conf, _errors = loopconf.parse(conf_path)
    old_owner, old_assumed = loopconf.resolve_owner(conf)
    _rewrite_conf_key(conf_path, "owner", args.owner)

    try:
        dash = _dashboard_module()
        dash.generate(root=args.root, loopconf_parse=loopconf.parse, schedule_parse=schedule.parse)
    except Exception as e:  # noqa: BLE001 — dashboard regen is best-effort; the owner change itself succeeded
        print(f"warning: dashboard regen failed: {e}", file=sys.stderr)

    old_text = f"{old_owner} (assumed)" if old_assumed else old_owner
    print(f"owner {args.name}: {old_text} -> {args.owner}")
    return 0


def cmd_dashboard(args):
    dash = _dashboard_module()
    out = dash.generate(root=args.root, loopconf_parse=loopconf.parse, schedule_parse=schedule.parse)
    print(out)
    return 0


def cmd_serve(args):
    import console

    return console.serve(args.root, args.port, allow_hosts=tuple(args.allow_host or ()))


_CONSOLE_LABEL = "com.roops.console"
_CONSOLE_UNIT = "loops-console.service"


def _console_plist_path(root):
    return os.path.join(root, "launchd", f"{_CONSOLE_LABEL}.plist")


def _console_unit_path():
    return os.path.join(_systemd_unit_dir(), _CONSOLE_UNIT)


def _console_port_and_hosts(root):
    env = loopconf.load_env(root)
    port = int(env.get("LOOPS_CONSOLE_PORT") or 8929)
    raw = env.get("LOOPS_CONSOLE_ALLOW_HOSTS") or ""
    hosts = [h.strip() for h in raw.split(",") if h.strip()]
    return port, hosts


def _console_plist_dict(root, port, allow_hosts):
    home = os.environ.get("HOME", os.path.expanduser("~"))
    log_dir = os.path.abspath(os.path.join(root, "state", "launchd-logs"))
    loopctl_bin = os.path.join(os.path.abspath(root), "bin", "loopctl")
    args = [sys.executable, loopctl_bin, "serve", "--port", str(port)]
    for host in allow_hosts:
        args += ["--allow-host", host]
    return {
        "Label": _CONSOLE_LABEL,
        "KeepAlive": True,
        "RunAtLoad": True,
        "WorkingDirectory": os.path.abspath(root),
        "ProgramArguments": args,
        "EnvironmentVariables": {
            "HOME": home,
            "PATH": _runtime_path(home),
            "LOOPS_ROOT": os.path.abspath(root),
        },
        "StandardOutPath": os.path.join(log_dir, "console.out.log"),
        "StandardErrorPath": os.path.join(log_dir, "console.err.log"),
    }


def _render_console_service(root, port, allow_hosts):
    root = os.path.abspath(root)
    home = os.environ.get("HOME", os.path.expanduser("~"))
    log_dir = os.path.abspath(os.path.join(root, "state", "launchd-logs"))
    loopctl_bin = os.path.join(root, "bin", "loopctl")
    exec_parts = [sys.executable, loopctl_bin, "serve", "--port", str(port)]
    for host in allow_hosts:
        exec_parts += ["--allow-host", host]
    exec_start = " ".join(exec_parts)
    return (
        "[Unit]\n"
        "Description=roops console\n"
        "After=network-online.target\n"
        "[Service]\n"
        "Type=simple\n"
        "Restart=always\n"
        "RestartSec=5\n"
        f"WorkingDirectory={root}\n"
        f"Environment=HOME={home}\n"
        f"Environment=PATH={_runtime_path(home)}\n"
        f"Environment=LOOPS_ROOT={root}\n"
        f"ExecStart={exec_start}\n"
        f"StandardOutput=append:{log_dir}/console.out.log\n"
        f"StandardError=append:{log_dir}/console.err.log\n"
        "[Install]\n"
        "WantedBy=default.target\n"
    )


def _console_existing_root(unit_path):
    if not os.path.isfile(unit_path):
        return None
    with open(unit_path) as f:
        for line in f:
            line = line.strip()
            if line.startswith("Environment=LOOPS_ROOT="):
                return line.split("Environment=LOOPS_ROOT=", 1)[1]
    return None


def _console_probe(port):
    url = os.environ.get("LOOPS_CONSOLE_PROBE_URL") or (
        f"http://127.0.0.1:{port}/api/state"
    )
    req = urllib.request.Request(url, headers={"Host": f"127.0.0.1:{port}"})
    try:
        with urllib.request.urlopen(req, timeout=2) as resp:
            return resp.getcode()
    except urllib.error.HTTPError as e:
        return e.code
    except Exception as e:
        return str(e)


def _console_verify(port):
    timeout_s = float(os.environ.get("LOOPCTL_CONSOLE_VERIFY_TIMEOUT_S", "30"))
    deadline = time.monotonic() + timeout_s
    while True:
        result = _console_probe(port)
        if result == 200:
            return True, timeout_s
        if time.monotonic() >= deadline:
            return False, timeout_s
        time.sleep(1)


def _console_loaded():
    if _install_backend() == "systemd":
        return _systemctl(["is-enabled", _CONSOLE_UNIT]).returncode == 0
    uid = os.getuid()
    return _launchctl(["print", f"gui/{uid}/{_CONSOLE_LABEL}"]).returncode == 0


def _console_uninstall(root, quiet=False):
    backend = _install_backend()
    if backend == "systemd":
        path = _console_unit_path()
        _systemctl(["disable", "--now", _CONSOLE_UNIT])
        removed = False
        if os.path.isfile(path):
            os.remove(path)
            removed = True
        _systemctl(["daemon-reload"])
        if not quiet:
            suffix = "" if removed else " (no unit was present)"
            print(f"uninstalled console{suffix}")
        return 0
    uid = os.getuid()
    _launchctl(["bootout", f"gui/{uid}/{_CONSOLE_LABEL}"])
    path = _console_plist_path(root)
    removed = False
    if os.path.isfile(path):
        os.remove(path)
        removed = True
    if not quiet:
        suffix = "" if removed else " (no unit was present)"
        print(f"uninstalled console{suffix}")
    return 0


def _console_install(args):
    root = args.root
    port, hosts = _console_port_and_hosts(root)
    backend = _install_backend()
    os.makedirs(os.path.join(root, "state", "launchd-logs"), exist_ok=True)
    if backend == "systemd":
        host_msgs = _host_checks(root)
        if host_msgs:
            for msg in host_msgs:
                print(f"refusing to install: {msg}", file=sys.stderr)
            return 1
        unit_path = _console_unit_path()
        existing = _console_existing_root(unit_path)
        if existing is not None and os.path.abspath(existing) != os.path.abspath(root):
            print(
                f"refusing: {_CONSOLE_UNIT} belongs to {existing}; uninstall it there first",
                file=sys.stderr,
            )
            return 1
        os.makedirs(_systemd_unit_dir(), exist_ok=True)
        with open(unit_path, "w") as f:
            f.write(_render_console_service(root, port, hosts))
        r = _systemctl(["daemon-reload"])
        if r.returncode != 0:
            print(
                f"install failed: systemctl daemon-reload error: {r.stderr.strip()}",
                file=sys.stderr,
            )
            return 1
        r = _systemctl(["enable", "--now", _CONSOLE_UNIT])
        if r.returncode != 0:
            print(
                f"install failed: systemctl enable error: {r.stderr.strip()}",
                file=sys.stderr,
            )
            return 1
    else:
        launchd_dir = os.path.join(root, "launchd")
        os.makedirs(launchd_dir, exist_ok=True)
        plist_path = _console_plist_path(root)
        with open(plist_path, "wb") as f:
            f.write(plistlib.dumps(_console_plist_dict(root, port, hosts), fmt=plistlib.FMT_XML))
        uid = os.getuid()
        _launchctl(["bootout", f"gui/{uid}/{_CONSOLE_LABEL}"])
        r = _launchctl(["bootstrap", f"gui/{uid}", plist_path])
        if r.returncode != 0:
            print(
                f"install failed: launchctl bootstrap error: {r.stderr.strip()}",
                file=sys.stderr,
            )
            return 1
    ok, timeout_s = _console_verify(port)
    if not ok:
        _console_uninstall(root, quiet=True)
        print(
            f"console install failed: no 200 from /api/state within {timeout_s:.0f}s",
            file=sys.stderr,
        )
        return 1
    print(f"installed console ({backend})")
    return 0


def _console_status(args):
    root = args.root
    backend = _install_backend()
    if backend == "systemd":
        path = _console_unit_path()
    else:
        path = _console_plist_path(root)
    present = os.path.isfile(path)
    loaded = _console_loaded()
    port, _hosts = _console_port_and_hosts(root)
    http_val = _console_probe(port)
    payload = {
        "backend": backend,
        "unit": {"present": present, "path": path},
        "loaded": loaded,
        "http": http_val,
    }
    if args.json:
        print(json.dumps(payload))
    else:
        print(f"backend: {backend}")
        print(f"unit: {'present' if present else 'absent'} ({path})")
        print(f"loaded: {'yes' if loaded else 'no'}")
        print(f"http: {http_val}")
    return 0 if present and loaded and http_val == 200 else 1


def cmd_console(args):
    action = getattr(args, "action", None) or "status"
    if action == "install":
        return _console_install(args)
    if action == "uninstall":
        return _console_uninstall(args.root)
    return _console_status(args)


def cmd_findings(args):
    root, loop_name = args.root, args.loop
    rows = _db_query(root, "open-findings", loop=loop_name)
    conn = _open_db_ro(root)
    now = datetime.now(timezone.utc)
    out_rows = []
    try:
        for r in rows:
            disp = _current_disposition(conn, loop_name, r["finding_id"])
            out_rows.append(
                {
                    "finding_id": r["finding_id"],
                    "severity": r["severity"],
                    "age": _age_days(r.get("first_seen_at"), now),
                    "times_seen": r["times_seen"],
                    "disposition": _format_disposition(disp),
                }
            )
    finally:
        if conn is not None:
            conn.close()

    if args.json:
        print(json.dumps(out_rows))
    else:
        if not out_rows:
            print(f"0 open findings for {loop_name}")
        else:
            _print_table(out_rows, ["finding_id", "severity", "age", "times_seen", "disposition"])
    return 0


def cmd_disposition(args, action):
    root = args.root
    if action == "dismiss" and not args.note:
        print("dismiss requires --note", file=sys.stderr)
        return 2
    if action == "snooze" and not args.until:
        print("snooze requires --until", file=sys.stderr)
        return 2

    db_args = [
        "dispose",
        "--loop",
        args.loop,
        "--finding-id",
        args.finding_id,
        "--action",
        action,
    ]
    note = getattr(args, "note", None)
    until = getattr(args, "until", None)
    if note:
        db_args += ["--note", note]
    if until:
        db_args += ["--until", until]

    r = _db_run(db_args, root)
    if r.returncode != 0:
        if r.stderr:
            print(r.stderr.strip(), file=sys.stderr)
        return 1

    try:
        dash = _dashboard_module()
        dash.generate(root=root, loopconf_parse=loopconf.parse, schedule_parse=schedule.parse)
    except Exception as e:  # noqa: BLE001 — dashboard regen is best-effort; disposition itself succeeded
        print(f"warning: dashboard regen failed: {e}", file=sys.stderr)

    print(f"{action} {args.loop} {args.finding_id}")
    return 0


def _print_import_analysis(skill_path, analysis):
    """Human-readable form of an `analyze()` dict — header, rubric table,
    flags line, precheck proposal (with the safety framing the controller
    required: commented lines are NOT live, and "[read-only?]" is a
    heuristic hint, not a guarantee), and a numbered answers-needed list.
    `--json` bypasses this entirely and prints the dict verbatim."""
    print(f"skill: {skill_path}")
    print(f"proposed name : {analysis.get('proposed_name')}")
    print(f"type          : {analysis.get('type')}")
    print(f"engine        : {analysis.get('engine')}")
    print(f"blocked       : {analysis.get('blocked')}")
    for reason in analysis.get("blocked_reasons") or []:
        print(f"  - {reason}")
    print()

    print("Rubric:")
    rubric = analysis.get("rubric", {}) or {}
    rows = [
        {
            "question": qid,
            "bucket": (rubric.get(qid) or {}).get("bucket", "—"),
            "value": (rubric.get(qid) or {}).get("value", "—"),
        }
        for qid in skill_import.RUBRIC_IDS
    ]
    _print_table(rows, ["question", "bucket", "value"])
    print()

    flags = analysis.get("flags", {}) or {}
    print("Flags: " + ", ".join(f"{k}={v}" for k, v in flags.items()))
    print()

    print(
        "Precheck proposal — COMMENTED PROPOSALS requiring human review before "
        'uncommenting any line into precheck.sh; "[read-only?]" is a heuristic '
        "hint, not a guarantee:"
    )
    precheck = analysis.get("precheck_proposal") or []
    if precheck:
        for line in precheck:
            print(f"  {line}")
    else:
        print("  (none proposed)")
    print()

    answers_needed = analysis.get("answers_needed") or []
    print(f"Answers needed ({len(answers_needed)}):")
    if not answers_needed:
        print("  (none)")
    for i, a in enumerate(answers_needed, start=1):
        print(f"  {i}. [{a.get('question_id')}] suggested_answerer={a.get('suggested_answerer')}")
        print(f"     {a.get('prompt')}")
        options = a.get("options") or []
        if options:
            opt_text = "; ".join(
                f"{o.get('id')} ({o.get('label')})" for o in options
            )
            print(f"     options: {opt_text}")


def cmd_import(args):
    if args.apply:
        return _cmd_import_apply(args)

    try:
        skill = skill_import.parse_skill(args.skill_path)
    except skill_import.SkillParseError as e:
        print(str(e), file=sys.stderr)
        return 1

    analysis = skill_import.analyze(skill)

    if args.json:
        print(json.dumps(analysis))
    else:
        _print_import_analysis(args.skill_path, analysis)
    return 0


def _cmd_import_apply(args):
    """`loopctl import <skill-path> --apply --answers <path>` (Task 12 —
    Amendment 2, 2026-07-30, docs/INTERFACES.md §8). Collision handling
    (existing `loops.d/<name>` dir) lives HERE rather than in
    `skill_import.apply()` — it's a `--overwrite` CLI concern, not something
    `apply()` itself needs to know about."""
    if not args.answers:
        print("--apply requires --answers <path to answers.json>", file=sys.stderr)
        return 2

    try:
        with open(args.answers, "r") as f:
            answers = json.load(f)
    except OSError as e:
        print(f"cannot read answers file {args.answers!r}: {e}", file=sys.stderr)
        return 1
    except ValueError as e:  # json.JSONDecodeError is a ValueError subclass
        print(f"invalid JSON in answers file {args.answers!r}: {e}", file=sys.stderr)
        return 1

    try:
        skill = skill_import.parse_skill(args.skill_path)
    except skill_import.SkillParseError as e:
        print(str(e), file=sys.stderr)
        return 1

    analysis = skill_import.analyze(skill)

    name = args.name or analysis["proposed_name"]
    if not loopconf.NAME_RE.match(name):
        print(
            f"invalid loop name {name!r}: must match ^[a-z][a-z0-9-]{{1,40}}$",
            file=sys.stderr,
        )
        return 2

    owner = args.owner or loopconf.DEFAULT_OWNER
    if not loopconf.NAME_RE.match(owner):
        print(
            f"invalid owner {owner!r}: must match ^[a-z][a-z0-9-]{{1,40}}$",
            file=sys.stderr,
        )
        return 2

    dest_dir = os.path.join(args.root, args.from_dir, name)
    if os.path.exists(dest_dir) and not args.overwrite:
        print(
            f"refusing to scaffold {name}: {dest_dir} already exists (use --overwrite)",
            file=sys.stderr,
        )
        return 1

    # Fix wave (2026-07-30, IMPORTANT #2a): --overwrite must never rewrite an
    # INSTALLED loop's files in place. The next launchd firing would run the
    # new prompt/loop.conf with none of the validate -> supervised run ->
    # install gauntlet re-applied, and (worse) apply() forces
    # schedule=manual for an acknowledged-blocked skill while the OLD plist
    # stays bootstrapped and keeps firing on its old schedule (see the
    # matching guard in bin/run-loop.sh). Refuse outright rather than adding
    # a force-past flag -- uninstall, re-import, re-validate, re-run,
    # re-install is the only supported path back in.
    if os.path.exists(dest_dir) and args.overwrite and _is_installed(args.root, name):
        print(
            f"refusing to overwrite {name}: it is currently installed — "
            f"run 'loopctl uninstall {name}' first, then re-import, "
            "loopctl validate, loopctl run, and loopctl install again",
            file=sys.stderr,
        )
        return 1

    try:
        written = skill_import.apply(skill, analysis, answers, dest_dir, owner=owner)
    except skill_import.SkillApplyError as e:
        print(str(e), file=sys.stderr)
        return 1
    _insert_requires_comment(os.path.join(dest_dir, "loop.conf"))

    _record_event(
        args.root,
        name,
        "imported",
        args.actor,
        detail={
            "source_skill": os.path.abspath(args.skill_path),
            "skill_sha256": skill["sha256"],
            "answers_provenance": answers.get("provenance") or {},
            "overwrite": bool(args.overwrite),
        },
    )

    if args.json:
        print(
            json.dumps(
                {
                    "name": name,
                    "dir": dest_dir,
                    "files": [os.path.basename(p) for p in written],
                }
            )
        )
    else:
        print(f"imported {name} -> {dest_dir}")
        for p in written:
            print(f"  wrote {os.path.relpath(p, args.root)}")
        print()
        print("Next steps (import never installs by itself):")
        print(f"  loopctl validate {name}")
        print(f"  loopctl run {name}       # read the report against ground truth")
        print(f"  loopctl install {name}")
    return 0


# ---------------------------------------------------------------------------
# argparse wiring
# ---------------------------------------------------------------------------

def _default_root():
    return os.environ.get("LOOPS_ROOT", os.path.expanduser("~/projects/loops"))


def _common_parser(*, hidden=False, suppress_defaults=False, include_from=True):
    """The `--root`/`--json`/`--from`/`--actor` flags shared by every verb's
    subparser, AND (Amendment 2 — 2026-07-30 fix round 1) by the top-level
    parser `p` itself, in two deliberately different flavors — conflating
    them was a verified Critical (see the long comment on `build_parser`
    below for the mechanism):

    - `hidden=True` (top-level `p`'s copy): real defaults, `help=SUPPRESS`
      on every flag — parseable (so a bare/pre-verb `--root R` etc. doesn't
      get mis-swallowed as a positional) but invisible in `loopctl --help`,
      which must read identically to before this amendment.
    - `suppress_defaults=True` (every subparser's copy): `default=SUPPRESS`
      on every flag, normal (visible, unchanged) help — so that when a verb
      invocation doesn't repeat a flag after the verb, the subparser's own
      re-parse doesn't clobber whatever the top-level parser already
      resolved for it with a fresh default.
    - `include_from=False` (merge with main, 2026-07-30): omit `--from`
      entirely. Only `serve` uses it — bin/console.py reads loops.d
      unconditionally and has no --from plumbing, so accepting the flag
      there would silently ignore it, a flag that lies.
    """
    common = argparse.ArgumentParser(add_help=False)
    help_ = argparse.SUPPRESS if hidden else None
    sup = argparse.SUPPRESS

    common.add_argument(
        "--root", default=(sup if suppress_defaults else _default_root()), help=help_
    )
    common.add_argument(
        "--json",
        action="store_true",
        default=(sup if suppress_defaults else False),
        help=help_,
    )
    if include_from:
        common.add_argument(
            "--from",
            dest="from_dir",
            choices=["loops.d", "examples"],
            default=(sup if suppress_defaults else "loops.d"),
            help=help_,
        )
    common.add_argument(
        "--actor",
        default=(sup if suppress_defaults else os.environ.get("USER", "unknown")),
        help=help_,
    )
    return common


def build_parser():
    # (Amendment 2 — 2026-07-30 fix round 1) `common_top` (real defaults,
    # hidden help) vs `common_sub` (SUPPRESS defaults, normal help) — see
    # `_common_parser`'s docstring for what each is for. The mechanism this
    # exists to avoid: argparse's `_SubParsersAction.__call__` parses a
    # chosen subparser's trailing tokens into a **fresh** sub-namespace
    # (`parser.parse_known_args(arg_strings, None)` — the `None` is the
    # fresh namespace, not the outer one), then unconditionally copies EVERY
    # key from that sub-namespace onto the outer namespace. If the
    # subparser's own `--root` etc. carry real defaults too, an invocation
    # like `loopctl --root R status --json` gets `--root R` correctly
    # resolved by `p` first, then immediately clobbered back to
    # `_default_root()` when `status`'s sub-namespace (which never saw
    # `--root` — it only received `["--json"]`) gets copied over wholesale.
    # `default=SUPPRESS` on the subparser's copy means that when a flag
    # isn't repeated after the verb, it's simply absent from the
    # sub-namespace — `vars(subnamespace)` doesn't contain the key at all —
    # so the copy loop never touches it, and the top-level parser's already-
    # resolved value survives. When a flag IS repeated after the verb (the
    # existing, most common convention — e.g. `status --root R`), the
    # subparser parses it for real and correctly overwrites the top-level's
    # default with it. Verified against the full flag x placement matrix in
    # `TestGlobalFlagPlacement`.
    common_top = _common_parser(hidden=True)
    common_sub = _common_parser(suppress_defaults=True)
    common_sub_nofrom = _common_parser(suppress_defaults=True, include_from=False)

    p = argparse.ArgumentParser(prog="loopctl", parents=[common_top])
    sub = p.add_subparsers(dest="verb")

    new_p = sub.add_parser("new", parents=[common_sub])
    new_p.add_argument("name")
    new_p.add_argument("--type", dest="type_", default="agent", choices=["agent", "watchdog"])
    new_p.add_argument("--engine", default="codex", choices=["codex", "claude"])
    new_p.add_argument("--owner", default=None)

    validate_p = sub.add_parser("validate", parents=[common_sub])
    validate_p.add_argument("name", nargs="?")
    validate_p.add_argument("--all", action="store_true")

    req_p = sub.add_parser("requirements", parents=[common_sub])
    req_p.add_argument("loop_names", nargs="*", metavar="name")
    req_p.add_argument("--no-live", action="store_true")

    run_p = sub.add_parser("run", parents=[common_sub])
    run_p.add_argument("name")
    run_p.add_argument("--trigger", default="manual")

    list_p = sub.add_parser("list", parents=[common_sub])
    list_p.add_argument("--tag", default=None)
    list_p.add_argument("--owner", default=None)

    status_p = sub.add_parser("status", parents=[common_sub])
    status_p.add_argument("name", nargs="?")

    install_p = sub.add_parser("install", parents=[common_sub])
    install_p.add_argument("name")

    uninstall_p = sub.add_parser("uninstall", parents=[common_sub])
    uninstall_p.add_argument("name")

    pause_p = sub.add_parser("pause", parents=[common_sub])
    pause_p.add_argument("name")

    resume_p = sub.add_parser("resume", parents=[common_sub])
    resume_p.add_argument("name")

    set_schedule_p = sub.add_parser("set-schedule", parents=[common_sub])
    set_schedule_p.add_argument("name")
    set_schedule_p.add_argument("spec")

    set_owner_p = sub.add_parser("set-owner", parents=[common_sub])
    set_owner_p.add_argument("name")
    set_owner_p.add_argument("owner")

    sub.add_parser("dashboard", parents=[common_sub])

    # `serve` takes the no-`--from` flavor (rationale in `_common_parser`).
    # `main()` additionally rejects a PRE-verb `--from` with `serve`: this
    # branch's top-level parser carries a hidden `--from` that main's did
    # not, so without that check the flag would be silently swallowed.
    serve_p = sub.add_parser("serve", parents=[common_sub_nofrom])
    serve_p.add_argument("--port", type=int, default=8929)
    serve_p.add_argument(
        "--allow-host",
        action="append",
        default=[],
        metavar="HOST",
        help="extra exact-match Host header accepted by the §13.1 origin gate "
        "(repeatable; for a trusted local reverse proxy that forwards the real Host)",
    )

    console_p = sub.add_parser("console", parents=[common_sub])
    console_p.add_argument(
        "action",
        nargs="?",
        default="status",
        choices=["install", "uninstall", "status"],
    )

    findings_p = sub.add_parser("findings", parents=[common_sub])
    findings_p.add_argument("loop")

    import_p = sub.add_parser("import", parents=[common_sub])
    import_p.add_argument("skill_path")
    import_group = import_p.add_mutually_exclusive_group(required=True)
    import_group.add_argument("--analyze", action="store_true")
    import_group.add_argument("--apply", action="store_true")
    import_p.add_argument("--answers", default=None)
    import_p.add_argument("--name", default=None)
    import_p.add_argument("--owner", default=None)
    import_p.add_argument("--overwrite", action="store_true")

    for verb in ("ack", "dismiss", "snooze", "reopen"):
        vp = sub.add_parser(verb, parents=[common_sub])
        vp.add_argument("loop")
        vp.add_argument("finding_id")
        if verb in ("ack", "dismiss"):
            vp.add_argument("--note", default=None)
        if verb == "snooze":
            vp.add_argument("--until", default=None)

    return p


def main(argv=None):
    parser = build_parser()
    # parse_known_args (not parse_args): `p` now carries --root/--json/--from/
    # --actor directly (see build_parser), so a bare invocation with no verb
    # — `loopctl` alone, or `loopctl --root R` — parses those flags onto
    # `args` same as always; `args.verb` just comes back None (no subparser
    # ever ran). `extra` is only non-empty for genuinely unrecognized
    # arguments — checked unconditionally below, BEFORE the verb-is-None
    # branch (Amendment 2 — 2026-07-30 fix round 2: checking verb-is-None
    # first let a typo'd flag like `--root-dir=X` silently print the
    # DEFAULT-root fleet at exit 0 instead of erroring — the exact
    # signal-loss the flag-placement fix eliminated for the "clobbered"
    # case, now closed for "genuinely unrecognized" too).
    args, extra = parser.parse_known_args(argv)

    if extra:
        parser.error(f"unrecognized arguments: {' '.join(extra)}")

    # (merge with main, 2026-07-30) `serve` deliberately has no `--from`
    # (bin/console.py reads loops.d unconditionally). On main that made a
    # pre-verb `--from` an argparse error; this branch's top-level parser
    # carries a hidden `--from`, which would otherwise swallow it silently —
    # exactly the flag-that-lies main's own comment set out to avoid.
    if getattr(args, "verb", None) == "serve" and any(
        a == "--from" or a.startswith("--from=") for a in (argv or sys.argv[1:])
    ):
        parser.error("serve does not accept --from (the console always reads loops.d)")

    dispatch = {
        "new": cmd_new,
        "validate": cmd_validate,
        "run": cmd_run,
        "list": cmd_list,
        "status": cmd_status,
        "install": cmd_install,
        "uninstall": cmd_uninstall,
        "pause": cmd_pause,
        "resume": cmd_resume,
        "set-schedule": cmd_set_schedule,
        "set-owner": cmd_set_owner,
        "dashboard": cmd_dashboard,
        "serve": cmd_serve,
        "console": cmd_console,
        "findings": cmd_findings,
        "import": cmd_import,
        "requirements": cmd_requirements,
        "ack": lambda a: cmd_disposition(a, "ack"),
        "dismiss": lambda a: cmd_disposition(a, "dismiss"),
        "snooze": lambda a: cmd_disposition(a, "snooze"),
        "reopen": lambda a: cmd_disposition(a, "reopen"),
    }

    if args.verb is None:
        # (fix round 2) An `extra`-free parse with no verb ISN'T always a
        # genuine bare invocation: `--root`/`--actor`/`--from` each take a
        # value, so a verb placed right after one of them with nothing
        # following gets silently consumed AS that value instead of ever
        # reaching the subparsers positional — `loopctl --actor status`
        # parses cleanly as actor="status", verb=None, extra=[] — nothing
        # for the check above to catch, yet the user's `status` verb just
        # vanished. This is indistinguishable from a genuinely-intended
        # literal value by parsing alone, so treat any raw argv token that
        # exactly matches a known verb name as a near-certain mistake and
        # refuse loudly rather than silently defaulting to the default
        # root. `--flag=value` syntax (e.g. `--actor=status`) is the
        # escape hatch: it never appears in argv as a bare token equal to
        # a verb name, so a genuinely-intended literal value survives.
        raw = argv if argv is not None else sys.argv[1:]
        collided = [tok for tok in raw if tok in dispatch]
        if collided:
            parser.error(
                f"ambiguous invocation: {collided[0]!r} looks like a verb but was "
                "consumed as a flag's value — use --flag=value syntax, or reorder, "
                "if that's intentional"
            )
        args.root = os.path.abspath(args.root)
        args.name = None
        return cmd_status(args)

    args.root = os.path.abspath(args.root)

    fn = dispatch.get(args.verb)
    if fn is None:
        parser.print_usage(sys.stderr)
        return 2
    return fn(args)


if __name__ == "__main__":
    sys.exit(main())
