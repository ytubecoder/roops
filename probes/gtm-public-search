#!/usr/bin/env python3
# probe: gtm-public-search
# probe-timeout-s: 180
# probe-writes: none
# probe-output: json
# probe-reads: existing ~/.codex/config.toml Tavily credential; tracked competitor registry under $MAGUYVA_REPO (default ~/projects/maguyva-marketing); four fixed public searches plus bounded per-competitor voice searches
"""Bounded public search. No credential values or provider errors leave this process."""

import hashlib
import html
import ipaddress
import json
import os
import re
import signal
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import parse_qsl, urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener

ENDPOINT = "https://api.tavily.com/search"
QUERIES = (
    ("public_reddit", "codebase context retrieval AI coding agents problems"),
    ("public_reddit", "MCP tools code search coding agents developer experience"),
    ("public_web", "codebase context retrieval AI coding agents limitations"),
    ("public_web", "MCP code intelligence tools coding agents developer experience"),
)
# Weekly voice of user: competitor registry rows without repos are searched by
# voice_hint on the community domains only. Competitors with repos get GitHub
# issue searches on the firstparty side (collect.py); no Tavily call for them.
REGISTRY_REL = "gc-actions/specs/inputs/competitor-registry.yaml"
VOICE_FAMILY = "public_voice"
VOICE_DOMAINS = ("reddit.com", "news.ycombinator.com", "forum.cursor.com", "github.com")
MAX_VOICE_SEARCHES = 12
MAX_COMPETITORS = 40
MAX_REGISTRY_BYTES = 200_000
ALARM_S = 165
SUCCESS = {"ok"}
ERRORS = {
    "config",
    "auth",
    "quota",
    "http",
    "network",
    "timeout",
    "size_limit",
    "malformed",
    "transport",
    "output_limit",
}
MAX_OUTPUT = 65536
COUNTERS = ("result_count", "unique_count", "duplicate_count", "rejected_count")


class CollectionError(Exception):
    pass


class DeadlineExpired(BaseException):
    """Escape per-source handling when the whole probe expires."""


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise CollectionError("http")


def key_from_config(path=None):
    # Exact existing field only; no environment fallback or config crawling.
    try:
        import tomllib

        path = path or Path.home() / ".codex/config.toml"
        with path.open("rb") as stream:
            data = tomllib.load(stream)
        key = data["mcp_servers"]["tavily"]["env"]["TAVILY_API_KEY"]
        if not isinstance(key, str) or not key.strip() or any(c.isspace() for c in key):
            raise ValueError
        return key
    except (ImportError, OSError, ValueError, KeyError, TypeError):
        raise CollectionError("config") from None


def registry_path(path=None):
    if path:
        return Path(path)
    repo = os.environ.get("MAGUYVA_REPO") or str(Path.home() / "projects/maguyva-marketing")
    return Path(repo) / REGISTRY_REL


def _label(value, maximum):
    if (
        not isinstance(value, str)
        or not value.strip()
        or len(value) > maximum
        or re.search(r"[\x00-\x1f\x7f@]", value)
    ):
        raise CollectionError("malformed")
    return " ".join(value.split())


def clean_competitors(rows):
    """Tracked registry rows with bounded fields. Shared by probe and collect.py."""
    if not isinstance(rows, list) or len(rows) > 200:
        raise CollectionError("malformed")
    competitors, slugs = [], set()
    for row in rows:
        if not isinstance(row, dict):
            raise CollectionError("malformed")
        if row.get("status") != "tracked":
            continue
        name = _label(row.get("name"), 80)
        slug = row.get("slug")
        if not isinstance(slug, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,39}", slug):
            raise CollectionError("malformed")
        if slug in slugs:
            raise CollectionError("malformed")
        slugs.add(slug)
        repos = row.get("repos") or []
        hints = row.get("voice_hints") or []
        if (
            not isinstance(repos, list)
            or not isinstance(hints, list)
            or len(repos) > 5
            or len(hints) > 6
        ):
            raise CollectionError("malformed")
        for repo in repos:
            if not isinstance(repo, str) or not re.fullmatch(
                r"[A-Za-z0-9_.-]{1,60}/[A-Za-z0-9_.-]{1,80}", repo
            ):
                raise CollectionError("malformed")
        competitors.append(
            {
                "name": name,
                "slug": slug,
                "status": "tracked",
                "repos": list(repos),
                "voice_hints": [_label(h, 80) for h in hints],
            }
        )
    if len(competitors) > MAX_COMPETITORS:
        raise CollectionError("malformed")
    return competitors


def load_registry(path=None):
    """Tracked competitors from the repo registry; PyYAML is required to parse it."""
    try:
        import yaml
    except ImportError:
        raise CollectionError("config") from None
    try:
        with registry_path(path).open("rb") as stream:
            raw = stream.read(MAX_REGISTRY_BYTES + 1)
    except OSError:
        raise CollectionError("config") from None
    if len(raw) > MAX_REGISTRY_BYTES:
        raise CollectionError("size_limit")
    try:
        data = yaml.safe_load(raw)
    except yaml.YAMLError:
        raise CollectionError("malformed") from None
    if not isinstance(data, dict) or data.get("schema_version") != 1:
        raise CollectionError("malformed")
    updated = data.get("updated")
    return {
        "updated": str(updated)[:10] if updated is not None else None,
        "competitors": clean_competitors(data.get("competitors")),
    }


def voice_plan(competitors):
    """(slug, hint) pairs for competitors without repos, in registry order."""
    plan = []
    for competitor in competitors:
        if competitor["repos"]:
            continue
        for hint in competitor["voice_hints"]:
            plan.append((competitor["slug"], hint))
    return plan


def safe_url(value):
    if (
        not isinstance(value, str)
        or len(value) > 1024
        or re.search(r"[\s\\\x00-\x1f]", value)
    ):
        return False
    try:
        parsed = urlsplit(value)
        host = parsed.hostname or ""
        if any(
            re.search(
                r"token|key|secret|password|signature|authorization", k, re.IGNORECASE
            )
            for k, _ in parse_qsl(parsed.query)
        ):
            return False
        if (
            parsed.scheme != "https"
            or parsed.username is not None
            or parsed.password is not None
            or parsed.port not in (None, 443)
            or "." not in host
            or host.endswith(
                (
                    ".local",
                    ".internal",
                    ".localhost",
                    ".test",
                    ".invalid",
                    ".example",
                    ".arpa",
                    ".ts.net",
                )
            )
        ):
            return False
        if not re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?", host):
            return False
        try:
            ipaddress.ip_address(host)
            return False
        except ValueError:
            return not all(c.isdigit() or c == "." for c in host)
    except ValueError:
        return False


def _host_in(host, domains):
    return any(host == d or host.endswith("." + d) for d in domains)


def excerpt(value):
    text = re.sub(r"<[^>]*>", " ", html.unescape(str(value or "")))
    text = re.sub(r"[\x00-\x1f\x7f]", " ", text)
    text = re.sub(r"[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}", "[address]", text)
    text = re.sub(r"(?<!\w)(?:/?u/|@)[\w-]+", "[handle]", text)
    return " ".join(text.split()[:22])[:300]


def timestamp(value):
    if not isinstance(value, str) or len(value) > 40:
        return None
    try:
        datetime.fromisoformat(value.replace("Z", "+00:00"))
        return value
    except ValueError:
        return None


def source_spec(family, query, now, competitor=None):
    return {
        "source_type": family,
        "query": query,
        "competitor": competitor,
        "method": "search",
        "provider": "tavily",
        "window": {
            "start_date": (now - timedelta(days=90)).date().isoformat(),
            "end_date": now.date().isoformat(),
            "days": 90,
        },
        "limit": 5,
        "status": "ok",
        "empty": True,
        "error": None,
        "records": [],
        "result_count": 0,
        "rejected_count": 0,
        "duplicate_count": 0,
        "unique_count": 0,
        "truncated": False,
        "truncated_count": 0,
    }


def fail_source(source, error):
    source.update(
        status="error",
        empty=False,
        error=error if error in ERRORS else "malformed",
        records=[],
        result_count=0,
        unique_count=0,
        duplicate_count=0,
        rejected_count=0,
        truncated=False,
        truncated_count=0,
    )
    return source


def failed_sources(now, error):
    return [fail_source(source_spec(f, q, now), error) for f, q in QUERIES]


def failed_voice_sources(now, plan, error):
    return [
        fail_source(source_spec(VOICE_FAMILY, hint, now, slug), error)
        for slug, hint in plan
    ]


def fetch_search(source, key, opener=None):
    body = {
        "query": source["query"],
        "max_results": 5,
        "search_depth": "basic",
        "auto_parameters": False,
        "include_answer": False,
        "include_raw_content": False,
        "include_images": False,
        "start_date": source["window"]["start_date"],
        "end_date": source["window"]["end_date"],
    }
    if source["source_type"] == "public_reddit":
        body["include_domains"] = ["reddit.com"]
    elif source["source_type"] == VOICE_FAMILY:
        body["include_domains"] = list(VOICE_DOMAINS)
    else:
        body["exclude_domains"] = ["reddit.com", "github.com"]
    request = Request(
        ENDPOINT,
        data=json.dumps(body).encode(),
        headers={
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json",
            "User-Agent": "Maguyva-GTM-research/1.0",
        },
    )
    with (opener or build_opener(NoRedirect()).open)(request, timeout=20) as response:
        raw = response.read(1_000_001)
    if len(raw) > 1_000_000:
        raise CollectionError("size_limit")
    return json.loads(raw)


def error_category(exc):
    if isinstance(exc, CollectionError):
        return str(exc) if str(exc) in ERRORS else "malformed"
    if isinstance(exc, HTTPError):
        # Close the body without reading/logging it; avoid destructor diagnostics.
        exc.close()
        return (
            "auth"
            if exc.code in (401, 403)
            else "quota"
            if exc.code in (429, 432, 433)
            else "http"
        )
    if isinstance(exc, TimeoutError) or (
        isinstance(exc, URLError) and isinstance(exc.reason, TimeoutError)
    ):
        return "timeout"
    if isinstance(exc, (OSError, URLError)):
        return "network"
    return "malformed"


def normalize_results(source, payload, stamp, seen):
    if not isinstance(payload, dict) or not isinstance(payload.get("results"), list):
        raise CollectionError("malformed")
    rows = payload["results"][: source["limit"]]
    source["result_count"] = len(rows)
    for row in rows:
        url = row.get("url") if isinstance(row, dict) else None
        if not safe_url(url):
            source["rejected_count"] += 1
            continue
        host = urlsplit(url).hostname
        reddit = host == "reddit.com" or host.endswith(".reddit.com")
        github = host == "github.com" or host.endswith(".github.com")
        family = source["source_type"]
        if (
            (family == "public_reddit" and not reddit)
            or (family == "public_web" and (reddit or github))
            or (family == VOICE_FAMILY and not _host_in(host, VOICE_DOMAINS))
        ):
            source["rejected_count"] += 1
            continue
        if url in seen:
            source["duplicate_count"] += 1
            continue
        seen.add(url)
        source["records"].append(
            {
                "id": "pub-" + hashlib.sha256(url.encode()).hexdigest()[:16],
                "url": url,
                "observed_at": stamp,
                "published_at": timestamp(row.get("published_date")),
                # Title shares the same single excerpt budget; never emitted separately.
                "text": excerpt(
                    str(row.get("title") or "") + " " + str(row.get("content") or "")
                ),
            }
        )
    source["unique_count"] = len(source["records"])
    source["status"] = "ok"
    source["empty"] = not rows
    if rows and source["rejected_count"] == len(rows):
        source.update(status="error", error="malformed")


def run_searches(specs, key, fetch, stamp, seen_for):
    """Run specs in order. A deadline marks the rest timeout; earlier results survive."""
    sources, expired = [], False
    for source in specs:
        seen = seen_for(source)
        if expired:
            fail_source(source, "timeout")
        elif key is None:
            fail_source(source, "config")
        else:
            try:
                payload = (fetch or fetch_search)(source, key)
                payload = json.loads(json.dumps(payload).replace(key, "[credential]"))
                normalize_results(source, payload, stamp, seen)
            except (OSError, ValueError, TypeError, AttributeError, CollectionError) as exc:
                fail_source(source, error_category(exc))
            except DeadlineExpired:
                expired = True
                fail_source(source, "timeout")
        sources.append(source)
    return sources


def fit_output(result, groups):
    """Drop whole records, largest source first, until the JSON fits MAX_OUTPUT.

    Every drop is explicit on the source (truncated, truncated_count). Returns the
    encoded output, or None when nothing is left to drop and it still does not fit.
    """
    while True:
        encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")) + "\n"
        if len(encoded.encode()) <= MAX_OUTPUT:
            return encoded
        candidates = [s for group in groups for s in result.get(group, []) if s["records"]]
        if not candidates:
            return None
        victim = max(candidates, key=lambda s: len(json.dumps(s["records"])))
        victim["records"].pop()
        victim["unique_count"] = len(victim["records"])
        victim["truncated"] = True
        victim["truncated_count"] += 1


def collect(now=None, fetch=None, config_path=None, registry=None):
    now = now or datetime.now(timezone.utc)
    stamp = now.isoformat()
    try:
        key = key_from_config(config_path)
    except CollectionError:
        key = None
    registry_block = {"status": "ok", "error": None, "updated": None, "competitors": []}
    try:
        loaded = load_registry(registry)
        registry_block.update(updated=loaded["updated"], competitors=loaded["competitors"])
    except CollectionError as exc:
        registry_block.update(status="error", error=error_category(exc))
    plan = voice_plan(registry_block["competitors"])
    voice_block = {
        "planned": len(plan),
        "run": min(len(plan), MAX_VOICE_SEARCHES),
        "truncated": len(plan) > MAX_VOICE_SEARCHES,
        "domains": list(VOICE_DOMAINS),
    }
    plan = plan[:MAX_VOICE_SEARCHES]
    # One pass so a deadline marks every later search, voice included. The
    # positioning searches share one dedupe set; voice dedupes per competitor.
    shared, per_competitor = set(), {}

    def seen_for(source):
        if source["source_type"] != VOICE_FAMILY:
            return shared
        return per_competitor.setdefault(source["competitor"], set())

    specs = [source_spec(f, q, now) for f, q in QUERIES] + [
        source_spec(VOICE_FAMILY, hint, now, slug) for slug, hint in plan
    ]
    searched = run_searches(specs, key, fetch, stamp, seen_for)
    return {
        "schema_version": 1,
        "generated_at": stamp,
        "sources": searched[: len(QUERIES)],
        "registry": registry_block,
        "voice_plan": voice_block,
        "voice_sources": searched[len(QUERIES) :],
    }


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ["--check"]:
        unmet = []
        try:
            key_from_config()
        except CollectionError:
            unmet.append("Tavily configuration")
        try:
            load_registry()
        except CollectionError as exc:
            unmet.append(f"competitor registry ({exc})")
        if unmet:
            print("unmet: " + "; ".join(unmet))
            return 1
        print("ok: Tavily configuration and competitor registry available")
        return 0
    if argv:
        print("refused: unexpected arguments", file=sys.stderr)
        return 64

    def deadline(signum, frame):
        raise DeadlineExpired

    signal.signal(signal.SIGALRM, deadline)
    signal.alarm(ALARM_S)
    try:
        result = collect()
    except DeadlineExpired:
        now = datetime.now(timezone.utc)
        result = {
            "schema_version": 1,
            "generated_at": now.isoformat(),
            "sources": failed_sources(now, "timeout"),
            "registry": {
                "status": "error",
                "error": "timeout",
                "updated": None,
                "competitors": [],
            },
            "voice_plan": {"planned": 0, "run": 0, "truncated": False, "domains": list(VOICE_DOMAINS)},
            "voice_sources": [],
        }
    finally:
        signal.alarm(0)
    encoded = fit_output(result, ("voice_sources", "sources"))
    if encoded is None:
        for source in result["sources"] + result["voice_sources"]:
            fail_source(source, "output_limit")
        encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")) + "\n"
    sys.stdout.write(encoded)
    # Source failures are data. The merged precheck decides all-source failure.
    return 0


if __name__ == "__main__":
    sys.exit(main())
