#!/usr/bin/env python3
# probe: opentwins-lock-signal
# probe-writes: none
# probe-output: json
# probe-reads: ~/.opentwins/workspaces/agent-twitter/memory/
"""Scan the last 3 OpenTwins twitter-agent memory files for lock markers.

Never prints file contents — only names and matching line numbers.
"""
import json
import os
import sys
from pathlib import Path

MEMDIR = Path.home() / ".opentwins" / "workspaces" / "agent-twitter" / "memory"
MARKERS = ("account has been locked", "account/access")


def check():
    if MEMDIR.is_dir():
        print("ok opentwins-lock-signal")
        return 0
    return 1


def scan():
    if not MEMDIR.is_dir():
        json.dump({"files": [], "hits": []}, sys.stdout)
        sys.stdout.write("\n")
        return 0
    names = sorted(p.name for p in MEMDIR.glob("20??-??-??.md") if p.is_file())
    files = names[-3:]
    hits = []
    for name in files:
        path = MEMDIR / name
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        for lineno, line in enumerate(text.splitlines(), start=1):
            lower = line.lower()
            if any(m in lower for m in MARKERS):
                hits.append({"file": name, "line": lineno})
    json.dump({"files": files, "hits": hits}, sys.stdout)
    sys.stdout.write("\n")
    return 0


def main(argv):
    if argv == ["--check"]:
        return check()
    return scan()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
